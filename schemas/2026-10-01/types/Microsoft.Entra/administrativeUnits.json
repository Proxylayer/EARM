{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entraarm.dev/schemas/2026-10-01/types/Microsoft.Entra/administrativeUnits.json",
  "title": "Microsoft.Entra/administrativeUnits",
  "description": "An administrative unit. The resource name is the displayName; the Graph id is pinned in state. Dynamic administrative units reject explicit members.",
  "type": "object",
  "properties": {
    "displayName": {
      "description": "Set from the resource name; declaring it is only allowed when it equals the name.",
      "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ]
    },
    "description": { "description": "Description.", "anyOf": [ { "type": [ "string", "null" ] }, { "$ref": "#/$defs/expression" } ] },
    "visibility": {
      "description": "HiddenMembership hides the unit's members from everyone but its administrators; null (default) is public.",
      "anyOf": [ { "type": [ "string", "null" ] }, { "$ref": "#/$defs/expression" } ]
    },
    "membershipType": {
      "description": "Assigned (default) or Dynamic.",
      "anyOf": [ { "type": "string", "enum": [ "Assigned", "Dynamic" ] }, { "$ref": "#/$defs/expression" } ]
    },
    "membershipRule": {
      "description": "Dynamic membership rule (requires membershipType: Dynamic).",
      "anyOf": [ { "type": [ "string", "null" ] }, { "$ref": "#/$defs/expression" } ]
    },
    "membershipRuleProcessingState": {
      "description": "On (default for dynamic units) or Paused.",
      "anyOf": [ { "type": "string", "enum": [ "On", "Paused" ] }, { "$ref": "#/$defs/expression" } ]
    },
    "isMemberManagementRestricted": {
      "description": "Restricted management unit; immutable after create. Assign scoped roles before adding members.",
      "anyOf": [ { "type": [ "boolean", "null" ] }, { "$ref": "#/$defs/expression" } ]
    },
    "members": {
      "description": "Administrative unit membership edge, target side: the full desired set of member object ids (users, groups, devices). Not allowed on dynamic units; members not listed are removed.",
      "anyOf": [
        { "type": "array", "items": { "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ] } },
        { "$ref": "#/$defs/expression" }
      ]
    }
  },
  "additionalProperties": true,
  "$defs": {
    "expression": { "type": "string", "pattern": "^\\[.*\\]$", "description": "A template expression, for example [parameters('env')]." }
  },
  "x-entraarm": {
    "type": "Microsoft.Entra/administrativeUnits",
    "parentType": null,
    "graphPath": "/directory/administrativeUnits",
    "apiVersions": { "2026-10-01-preview": "v1.0", "2026-10-01-preview.beta": "beta" },
    "nameMapsTo": "displayName",
    "nameKind": "displayName",
    "namePattern": "^\\S(.{0,254}\\S)?$",
    "keyProperties": ["displayName"],
    "requiredOnCreate": [],
    "defaults": {},
    "immutable": ["isMemberManagementRestricted"],
    "createOnly": [],
    "secure": [],
    "relationships": [
      { "property": "members", "kind": "administrativeUnitMembership", "side": "target" }
    ],
    "memberKey": {},
    "stripOnRead": ["id", "deletedDateTime"],
    "nullable": {},
    "permissions": {
      "application": ["AdministrativeUnit.ReadWrite.All"],
      "delegated": ["AdministrativeUnit.ReadWrite.All"],
      "roles": ["Privileged Role Administrator"]
    }
  }
}
