{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/users.json",
  "title": "Microsoft.Entra/users",
  "description": "A member user. The resource name is the userPrincipalName. passwordProfile is create-only and never diffed; when omitted a random password is generated and returned as a securestring output. Properties not listed here are passed through to Graph unchanged.",
  "type": "object",
  "properties": {
    "userPrincipalName": {
      "description": "Set from the resource name; declaring it is only allowed when it equals the name.",
      "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ]
    },
    "displayName": {
      "description": "Required on create.",
      "anyOf": [ { "type": "string", "minLength": 1, "maxLength": 256 }, { "$ref": "#/$defs/expression" } ]
    },
    "accountEnabled": { "description": "Defaults to true.", "anyOf": [ { "type": "boolean" }, { "$ref": "#/$defs/expression" } ] },
    "mailNickname": {
      "description": "Defaults to the sanitised local part of the UPN.",
      "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ]
    },
    "givenName": { "description": "First name.", "anyOf": [ { "type": [ "string", "null" ] }, { "$ref": "#/$defs/expression" } ] },
    "surname": { "description": "Last name.", "anyOf": [ { "type": [ "string", "null" ] }, { "$ref": "#/$defs/expression" } ] },
    "jobTitle": { "description": "Job title.", "anyOf": [ { "type": [ "string", "null" ] }, { "$ref": "#/$defs/expression" } ] },
    "department": { "description": "Department.", "anyOf": [ { "type": [ "string", "null" ] }, { "$ref": "#/$defs/expression" } ] },
    "companyName": { "description": "Company name.", "anyOf": [ { "type": [ "string", "null" ] }, { "$ref": "#/$defs/expression" } ] },
    "officeLocation": { "description": "Office location.", "anyOf": [ { "type": [ "string", "null" ] }, { "$ref": "#/$defs/expression" } ] },
    "usageLocation": {
      "description": "Two-letter upper-case ISO 3166-1 country code; required for assignedLicenses.",
      "anyOf": [ { "type": [ "string", "null" ], "pattern": "^[A-Z]{2}$" }, { "$ref": "#/$defs/expression" } ]
    },
    "userType": {
      "description": "Member or Guest. EARM creates members; guests come from invitations.",
      "anyOf": [ { "type": "string", "enum": [ "Member", "Guest" ] }, { "$ref": "#/$defs/expression" } ]
    },
    "otherMails": {
      "description": "Additional email addresses.",
      "anyOf": [
        { "type": "array", "items": { "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ] } },
        { "$ref": "#/$defs/expression" }
      ]
    },
    "businessPhones": {
      "description": "Business phone numbers (at most one).",
      "anyOf": [
        { "type": "array", "items": { "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ] } },
        { "$ref": "#/$defs/expression" }
      ]
    },
    "mobilePhone": { "description": "Mobile phone.", "anyOf": [ { "type": [ "string", "null" ] }, { "$ref": "#/$defs/expression" } ] },
    "employeeId": { "description": "Employee id.", "anyOf": [ { "type": [ "string", "null" ] }, { "$ref": "#/$defs/expression" } ] },
    "employeeType": { "description": "Employee type.", "anyOf": [ { "type": [ "string", "null" ] }, { "$ref": "#/$defs/expression" } ] },
    "preferredLanguage": {
      "description": "Preferred language (ISO 639-1 with optional ISO 3166-1 region).",
      "anyOf": [ { "type": [ "string", "null" ] }, { "$ref": "#/$defs/expression" } ]
    },
    "city": { "description": "City.", "anyOf": [ { "type": [ "string", "null" ] }, { "$ref": "#/$defs/expression" } ] },
    "state": { "description": "State or province.", "anyOf": [ { "type": [ "string", "null" ] }, { "$ref": "#/$defs/expression" } ] },
    "country": { "description": "Country or region.", "anyOf": [ { "type": [ "string", "null" ] }, { "$ref": "#/$defs/expression" } ] },
    "postalCode": { "description": "Postal code.", "anyOf": [ { "type": [ "string", "null" ] }, { "$ref": "#/$defs/expression" } ] },
    "streetAddress": { "description": "Street address.", "anyOf": [ { "type": [ "string", "null" ] }, { "$ref": "#/$defs/expression" } ] },
    "passwordProfile": {
      "description": "Create-only, write-only, never diffed. password is secure (rendered *** everywhere).",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "password": {
              "description": "The initial password; use a securestring parameter or a Key Vault reference.",
              "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ]
            },
            "forceChangePasswordNextSignIn": {
              "description": "Defaults to true.",
              "anyOf": [ { "type": "boolean" }, { "$ref": "#/$defs/expression" } ]
            },
            "forceChangePasswordNextSignInWithMfa": {
              "description": "Require MFA before the password change.",
              "anyOf": [ { "type": "boolean" }, { "$ref": "#/$defs/expression" } ]
            }
          }
        },
        { "$ref": "#/$defs/expression" }
      ]
    },
    "manager": {
      "description": "Manager edge: the manager's user object id (reference(...).id); null removes the manager, absent leaves it untouched.",
      "anyOf": [ { "type": [ "string", "null" ] }, { "$ref": "#/$defs/expression" } ]
    },
    "memberOf": {
      "description": "Group membership edge, principal side: group object ids (never dynamic groups).",
      "anyOf": [
        { "type": "array", "items": { "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ] } },
        { "$ref": "#/$defs/expression" }
      ]
    },
    "ownerOf": {
      "description": "Ownership edge, principal side: object ids of applications, service principals or groups this user must own.",
      "anyOf": [
        { "type": "array", "items": { "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ] } },
        { "$ref": "#/$defs/expression" }
      ]
    },
    "administrativeUnits": {
      "description": "Administrative unit membership edge, principal side: administrative unit object ids.",
      "anyOf": [
        { "type": "array", "items": { "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ] } },
        { "$ref": "#/$defs/expression" }
      ]
    },
    "appRoleAssignments": {
      "description": "App role assignment edge, principal side (applied by the edge pass, tracked in state): [{ resourceId | resourceAppId, appRole | appRoleId }]. appRole is the role's value, resolved against the resource service principal; 00000000-0000-0000-0000-000000000000 is default access.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "resourceId": {
                    "description": "Object id of the resource service principal.",
                    "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ]
                  },
                  "resourceAppId": {
                    "description": "Application (client) id of the resource; resolved to its service principal.",
                    "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ]
                  },
                  "appRole": {
                    "description": "Value of the app role on the resource, for example Orders.Admin.",
                    "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ]
                  },
                  "appRoleId": {
                    "description": "Id of the app role (00000000-0000-0000-0000-000000000000 = default access).",
                    "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ]
                  }
                },
                "additionalProperties": false,
                "allOf": [
                  { "anyOf": [ { "required": [ "resourceId" ] }, { "required": [ "resourceAppId" ] } ] },
                  { "anyOf": [ { "required": [ "appRole" ] }, { "required": [ "appRoleId" ] } ] }
                ]
              },
              { "$ref": "#/$defs/expression" }
            ]
          }
        },
        { "$ref": "#/$defs/expression" }
      ]
    },
    "directoryRoles": {
      "description": "Directory role assignment edge, principal side (applied by the edge pass, tracked in state): [{ role | roleDefinitionId, directoryScopeId | administrativeUnit }]. role is a role template id, a built-in role display name, a custom role display name or its id. The scope defaults to '/' (tenant).",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "role": {
                    "description": "Role template id, built-in role name (Global Reader), custom role display name or custom role id.",
                    "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ]
                  },
                  "roleDefinitionId": {
                    "description": "The role template id (roleTemplate('Display Name')); use role for names.",
                    "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ]
                  },
                  "directoryScopeId": {
                    "description": "Scope: '/' (tenant, default), '/administrativeUnits/{id}' or '/{applicationObjectId}'.",
                    "anyOf": [ { "type": "string", "pattern": "^/" }, { "$ref": "#/$defs/expression" } ]
                  },
                  "administrativeUnit": {
                    "description": "Sugar for an administrative-unit scope: the unit's object id or its template name (reference('Orders AU').id).",
                    "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ]
                  }
                },
                "additionalProperties": false,
                "anyOf": [ { "required": [ "role" ] }, { "required": [ "roleDefinitionId" ] } ]
              },
              { "$ref": "#/$defs/expression" }
            ]
          }
        },
        { "$ref": "#/$defs/expression" }
      ]
    },
    "assignedLicenses": {
      "description": "Licenses (requires usageLocation) (action-backed, direct assignments only; group-inherited licenses are never touched): [{ skuId | skuPartNumber, disabledPlans }].",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "skuId": { "description": "Subscribed SKU id.", "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ] },
                  "skuPartNumber": {
                    "description": "SKU part number, for example ENTERPRISEPREMIUM; resolved with GET /subscribedSkus.",
                    "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ]
                  },
                  "disabledPlans": {
                    "description": "Service plan ids to disable within the SKU.",
                    "anyOf": [
                      { "type": "array", "items": { "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ] } },
                      { "$ref": "#/$defs/expression" }
                    ]
                  }
                },
                "additionalProperties": false,
                "anyOf": [ { "required": [ "skuId" ] }, { "required": [ "skuPartNumber" ] } ]
              },
              { "$ref": "#/$defs/expression" }
            ]
          }
        },
        { "$ref": "#/$defs/expression" }
      ]
    }
  },
  "additionalProperties": true,
  "$defs": {
    "expression": { "type": "string", "pattern": "^\\[.*\\]$", "description": "A template expression, for example [parameters('env')]." }
  },
  "x-earm": {
    "type": "Microsoft.Entra/users",
    "parentType": null,
    "graphPath": "/users",
    "apiVersions": { "2026-10-01-preview": "v1.0", "2026-10-01-preview.beta": "beta" },
    "nameMapsTo": "userPrincipalName",
    "nameKind": "userPrincipalName",
    "namePattern": "^[^@\\s]+@[^@\\s]+$",
    "keyProperties": ["userPrincipalName"],
    "requiredOnCreate": ["displayName"],
    "defaults": { "accountEnabled": true, "passwordProfile.forceChangePasswordNextSignIn": true },
    "immutable": ["userPrincipalName"],
    "createOnly": ["passwordProfile"],
    "secure": ["passwordProfile.password"],
    "relationships": [
      { "property": "manager", "kind": "manager", "side": "principal" },
      { "property": "memberOf", "kind": "groupMembership", "side": "principal" },
      { "property": "ownerOf", "kind": "ownership", "side": "principal" },
      { "property": "administrativeUnits", "kind": "administrativeUnitMembership", "side": "principal" },
      { "property": "appRoleAssignments", "kind": "appRoleAssignment", "side": "principal" },
      { "property": "directoryRoles", "kind": "directoryRoleAssignment", "side": "principal" },
      { "property": "assignedLicenses", "kind": "license", "side": "principal" }
    ],
    "memberKey": {},
    "stripOnRead": ["id", "createdDateTime", "deletedDateTime", "mail", "proxyAddresses", "imAddresses", "onPremisesSyncEnabled", "onPremisesLastSyncDateTime", "onPremisesSecurityIdentifier", "onPremisesDomainName", "onPremisesSamAccountName", "onPremisesUserPrincipalName", "onPremisesImmutableId", "onPremisesDistinguishedName", "onPremisesExtensionAttributes", "onPremisesProvisioningErrors", "securityIdentifier", "signInActivity", "lastPasswordChangeDateTime", "signInSessionsValidFromDateTime", "refreshTokensValidFromDateTime", "assignedLicenses", "assignedPlans", "provisionedPlans", "licenseAssignmentStates", "externalUserState", "externalUserStateChangeDateTime", "creationType", "identities", "serviceProvisioningErrors"],
    "nullable": {},
    "permissions": {
      "application": ["User.ReadWrite.All"],
      "delegated": ["User.ReadWrite.All"],
      "roles": ["User Administrator"],
      "conditional": {
        "memberOf": { "application": ["GroupMember.ReadWrite.All"], "roles": ["Groups Administrator"] },
        "administrativeUnits": { "application": ["AdministrativeUnit.ReadWrite.All"], "roles": ["Privileged Role Administrator"] },
        "assignedLicenses": { "application": ["Organization.Read.All"], "roles": ["License Administrator"] },
        "appRoleAssignments": { "application": ["AppRoleAssignment.ReadWrite.All", "Application.Read.All"] },
        "directoryRoles": { "application": ["RoleManagement.ReadWrite.Directory"], "roles": ["Privileged Role Administrator"] }
      }
    }
  }
}
