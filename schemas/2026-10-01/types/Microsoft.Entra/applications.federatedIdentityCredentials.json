{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/applications.federatedIdentityCredentials.json",
  "title": "Microsoft.Entra/applications/federatedIdentityCredentials",
  "description": "A federated identity credential of an application. The child name is the credential's Graph name (3-120 characters: letters, digits, '-' and '_', starting with a letter or digit). Upsert via PATCH /applications(uniqueName='parent')/federatedIdentityCredentials(name='child') with Prefer: create-if-missing.",
  "type": "object",
  "properties": {
    "name": {
      "description": "Set from the resource name; declaring it is only allowed when it equals the name.",
      "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ]
    },
    "issuer": {
      "description": "Required: the https issuer URL of the external identity provider.",
      "anyOf": [ { "type": "string", "minLength": 1 }, { "$ref": "#/$defs/expression" } ]
    },
    "subject": {
      "description": "Required: the subject claim (case-sensitive); issuer + subject must be unique per application.",
      "anyOf": [ { "type": "string", "minLength": 1 }, { "$ref": "#/$defs/expression" } ]
    },
    "audiences": {
      "description": "Defaults to [\"api://AzureADTokenExchange\"].",
      "anyOf": [
        { "type": "array", "items": { "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ] } },
        { "$ref": "#/$defs/expression" }
      ]
    },
    "description": {
      "description": "Description (up to 600 characters).",
      "anyOf": [ { "type": [ "string", "null" ] }, { "$ref": "#/$defs/expression" } ]
    },
    "claimsMatchingExpression": {
      "description": "Flexible federated identity credential expression. Beta apiVersion (2026-10-01-preview.beta) only.",
      "anyOf": [
        {
          "type": [ "object", "null" ],
          "properties": {
            "languageVersion": {
              "description": "Expression language version (1).",
              "anyOf": [ { "type": "integer", "enum": [ 1 ] }, { "$ref": "#/$defs/expression" } ]
            },
            "value": { "description": "The claims matching expression.", "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ] }
          }
        },
        { "$ref": "#/$defs/expression" }
      ]
    }
  },
  "additionalProperties": true,
  "$defs": {
    "expression": { "type": "string", "pattern": "^\\[.*\\]$", "description": "A template expression, for example [parameters('env')]." }
  },
  "x-earm": {
    "type": "Microsoft.Entra/applications/federatedIdentityCredentials",
    "parentType": "Microsoft.Entra/applications",
    "graphPath": "/applications/{parentId}/federatedIdentityCredentials",
    "apiVersions": { "2026-10-01-preview": "v1.0", "2026-10-01-preview.beta": "beta" },
    "nameMapsTo": "name",
    "nameKind": "childName",
    "namePattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,119}$",
    "keyProperties": ["name"],
    "requiredOnCreate": ["issuer", "subject"],
    "defaults": { "audiences": ["api://AzureADTokenExchange"] },
    "immutable": ["name"],
    "createOnly": [],
    "secure": [],
    "relationships": [],
    "memberKey": {},
    "stripOnRead": ["id"],
    "nullable": {},
    "permissions": {
      "application": ["Application.ReadWrite.OwnedBy", "Application.ReadWrite.All"],
      "roles": ["Application Developer", "Cloud Application Administrator", "Application Administrator"]
    }
  }
}
