{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/authenticationMethodConfigurations.json",
  "title": "Microsoft.Entra/authenticationMethodConfigurations",
  "description": "An authentication method configuration of the tenant authentication methods policy (a tenant singleton). The resource name is the method id (fido2, temporaryAccessPass, x509Certificate, microsoftAuthenticator, sms, voice, email, softwareOath; case-insensitive); @odata.type is derived from it. Never created: a missing configuration is an error. Updated with a merge PATCH; undeclared sub-properties of declared objects keep their live values. Delete resets fido2, temporaryAccessPass and x509Certificate to the Microsoft default; the other methods are kept (NotDeletable). Properties not listed here are passed through to Graph unchanged.",
  "type": "object",
  "properties": {
    "id": {
      "description": "Set from the resource name; declaring it is only allowed when it names the same method.",
      "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ]
    },
    "@odata.type": {
      "description": "Derived from the resource name; declaring it is only allowed when it matches the method.",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "#microsoft.graph.fido2AuthenticationMethodConfiguration",
            "#microsoft.graph.temporaryAccessPassAuthenticationMethodConfiguration",
            "#microsoft.graph.x509CertificateAuthenticationMethodConfiguration",
            "#microsoft.graph.microsoftAuthenticatorAuthenticationMethodConfiguration",
            "#microsoft.graph.smsAuthenticationMethodConfiguration",
            "#microsoft.graph.voiceAuthenticationMethodConfiguration",
            "#microsoft.graph.emailAuthenticationMethodConfiguration",
            "#microsoft.graph.softwareOathAuthenticationMethodConfiguration"
          ]
        },
        { "$ref": "#/$defs/expression" }
      ]
    },
    "state": {
      "description": "enabled or disabled.",
      "anyOf": [ { "type": "string", "enum": [ "enabled", "disabled" ] }, { "$ref": "#/$defs/expression" } ]
    },
    "includeTargets": {
      "description": "Groups (or all_users) enabled for the method; compared as a set by id.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "description": "Required: a group object id, or all_users. Members are matched by id (a set).",
                    "anyOf": [ { "type": "string", "minLength": 1 }, { "$ref": "#/$defs/expression" } ]
                  },
                  "targetType": {
                    "description": "group (or user).",
                    "anyOf": [ { "type": "string", "enum": [ "group", "user", "unknownFutureValue" ] }, { "$ref": "#/$defs/expression" } ]
                  },
                  "isRegistrationRequired": {
                    "description": "Whether users are nudged to register the method.",
                    "anyOf": [ { "type": "boolean" }, { "$ref": "#/$defs/expression" } ]
                  },
                  "authenticationMode": {
                    "description": "microsoftAuthenticator only: any, push or deviceBasedPush.",
                    "anyOf": [
                      { "type": "string", "enum": [ "any", "push", "deviceBasedPush", "unknownFutureValue" ] },
                      { "$ref": "#/$defs/expression" }
                    ]
                  },
                  "allowedPasskeyProfiles": {
                    "description": "fido2 only: ids of the passkey profiles this target may use.",
                    "anyOf": [
                      { "type": "array", "items": { "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ] } },
                      { "$ref": "#/$defs/expression" }
                    ]
                  }
                },
                "required": [ "id" ]
              },
              { "$ref": "#/$defs/expression" }
            ]
          }
        },
        { "$ref": "#/$defs/expression" }
      ]
    },
    "excludeTargets": {
      "description": "Groups excluded from the method; compared as a set by id.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "description": "Required: a group object id.",
                    "anyOf": [ { "type": "string", "minLength": 1 }, { "$ref": "#/$defs/expression" } ]
                  },
                  "targetType": {
                    "description": "group.",
                    "anyOf": [ { "type": "string", "enum": [ "group", "user", "unknownFutureValue" ] }, { "$ref": "#/$defs/expression" } ]
                  }
                },
                "required": [ "id" ]
              },
              { "$ref": "#/$defs/expression" }
            ]
          }
        },
        { "$ref": "#/$defs/expression" }
      ]
    },
    "isSelfServiceRegistrationAllowed": {
      "description": "fido2: whether users can register new passkeys.",
      "anyOf": [ { "type": "boolean" }, { "$ref": "#/$defs/expression" } ]
    },
    "isAttestationEnforced": {
      "description": "fido2 (deprecated by Microsoft, removed October 2027; use passkeyProfiles): enforce attestation at registration. Declaring it raises DeprecatedAuthenticationMethodProperty.",
      "anyOf": [ { "type": "boolean" }, { "$ref": "#/$defs/expression" } ]
    },
    "keyRestrictions": {
      "description": "fido2 (deprecated by Microsoft, removed October 2027; use passkeyProfiles): the AAGUID allow- or block-list. Declaring it raises DeprecatedAuthenticationMethodProperty.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "isEnforced": {
              "description": "Whether the AAGUID list is enforced.",
              "anyOf": [ { "type": "boolean" }, { "$ref": "#/$defs/expression" } ]
            },
            "enforcementType": {
              "description": "allow (only the listed models) or block (every model but the listed ones). An enforced allow-list needs at least one AAGUID.",
              "anyOf": [ { "type": "string", "enum": [ "allow", "block" ] }, { "$ref": "#/$defs/expression" } ]
            },
            "aaGuids": {
              "description": "Authenticator model AAGUIDs, compared as a set and normalised to lower case.",
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
                      { "$ref": "#/$defs/expression" }
                    ]
                  }
                },
                { "$ref": "#/$defs/expression" }
              ]
            }
          }
        },
        { "$ref": "#/$defs/expression" }
      ]
    },
    "passkeyProfiles": {
      "description": "fido2: passkey profiles, compared as a set by id.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "description": "Required: the profile id (the default profile is 00000000-0000-0000-0000-000000000001).",
                    "anyOf": [ { "type": "string", "minLength": 1 }, { "$ref": "#/$defs/expression" } ]
                  },
                  "name": { "description": "Profile name.", "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ] },
                  "passkeyTypes": {
                    "description": "Comma-separated passkey types, for example deviceBound,synced.",
                    "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ]
                  },
                  "attestationEnforcement": {
                    "description": "Attestation enforcement, for example disabled or registrationOnly.",
                    "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ]
                  },
                  "keyRestrictions": {
                    "description": "The profile AAGUID allow- or block-list.",
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "isEnforced": {
                            "description": "Whether the AAGUID list is enforced.",
                            "anyOf": [ { "type": "boolean" }, { "$ref": "#/$defs/expression" } ]
                          },
                          "enforcementType": {
                            "description": "allow (only the listed models) or block (every model but the listed ones). An enforced allow-list needs at least one AAGUID.",
                            "anyOf": [ { "type": "string", "enum": [ "allow", "block" ] }, { "$ref": "#/$defs/expression" } ]
                          },
                          "aaGuids": {
                            "description": "Authenticator model AAGUIDs, compared as a set and normalised to lower case.",
                            "anyOf": [
                              {
                                "type": "array",
                                "items": {
                                  "anyOf": [
                                    { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
                                    { "$ref": "#/$defs/expression" }
                                  ]
                                }
                              },
                              { "$ref": "#/$defs/expression" }
                            ]
                          }
                        }
                      },
                      { "$ref": "#/$defs/expression" }
                    ]
                  }
                },
                "required": [ "id" ]
              },
              { "$ref": "#/$defs/expression" }
            ]
          }
        },
        { "$ref": "#/$defs/expression" }
      ]
    },
    "defaultPasskeyProfile": {
      "description": "fido2: the id of the baseline passkey profile.",
      "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ]
    },
    "defaultLifetimeInMinutes": {
      "description": "temporaryAccessPass: default lifetime; between minimumLifetimeInMinutes and maximumLifetimeInMinutes.",
      "anyOf": [ { "type": "integer", "minimum": 10, "maximum": 43200 }, { "$ref": "#/$defs/expression" } ]
    },
    "defaultLength": {
      "description": "temporaryAccessPass: default pass length (8-48 characters).",
      "anyOf": [ { "type": "integer", "minimum": 8, "maximum": 48 }, { "$ref": "#/$defs/expression" } ]
    },
    "minimumLifetimeInMinutes": {
      "description": "temporaryAccessPass: minimum lifetime (10-43200 minutes).",
      "anyOf": [ { "type": "integer", "minimum": 10, "maximum": 43200 }, { "$ref": "#/$defs/expression" } ]
    },
    "maximumLifetimeInMinutes": {
      "description": "temporaryAccessPass: maximum lifetime (10-43200 minutes).",
      "anyOf": [ { "type": "integer", "minimum": 10, "maximum": 43200 }, { "$ref": "#/$defs/expression" } ]
    },
    "isUsableOnce": {
      "description": "temporaryAccessPass: restrict every pass to one-time use.",
      "anyOf": [ { "type": "boolean" }, { "$ref": "#/$defs/expression" } ]
    },
    "authenticationModeConfiguration": {
      "description": "x509Certificate: the default binding and the binding rules. Undeclared rules keep their live value (EARM resends them, since Graph replaces the object whole); an explicit [] clears them.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "x509CertificateAuthenticationDefaultMode": {
              "description": "x509CertificateSingleFactor or x509CertificateMultiFactor.",
              "anyOf": [
                { "type": "string", "enum": [ "x509CertificateSingleFactor", "x509CertificateMultiFactor" ] },
                { "$ref": "#/$defs/expression" }
              ]
            },
            "rules": {
              "description": "Binding rules (policy OID or issuer subject to an authentication mode).",
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "x509CertificateRuleType": {
                            "description": "issuerSubject, policyOID, issuerSubjectAndPolicyOID...",
                            "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ]
                          },
                          "identifier": {
                            "description": "The issuer subject or policy OID.",
                            "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/expression" } ]
                          },
                          "x509CertificateAuthenticationMode": {
                            "description": "x509CertificateSingleFactor or x509CertificateMultiFactor.",
                            "anyOf": [
                              { "type": "string", "enum": [ "x509CertificateSingleFactor", "x509CertificateMultiFactor" ] },
                              { "$ref": "#/$defs/expression" }
                            ]
                          }
                        }
                      },
                      { "$ref": "#/$defs/expression" }
                    ]
                  }
                },
                { "$ref": "#/$defs/expression" }
              ]
            }
          }
        },
        { "$ref": "#/$defs/expression" }
      ]
    },
    "certificateUserBindings": {
      "description": "x509Certificate: certificate field to user attribute bindings (by priority).",
      "anyOf": [
        { "type": "array", "items": { "anyOf": [ { "type": "object" }, { "$ref": "#/$defs/expression" } ] } },
        { "$ref": "#/$defs/expression" }
      ]
    },
    "certificateAuthorityScopes": {
      "description": "x509Certificate: issuing CA scopes.",
      "anyOf": [
        { "type": "array", "items": { "anyOf": [ { "type": "object" }, { "$ref": "#/$defs/expression" } ] } },
        { "$ref": "#/$defs/expression" }
      ]
    },
    "crlValidationConfiguration": {
      "description": "x509Certificate: certificate revocation list validation.",
      "anyOf": [ { "type": "object" }, { "$ref": "#/$defs/expression" } ]
    },
    "issuerHintsConfiguration": {
      "description": "x509Certificate: issuer hints for the certificate picker.",
      "anyOf": [ { "type": "object" }, { "$ref": "#/$defs/expression" } ]
    },
    "featureSettings": {
      "description": "microsoftAuthenticator: feature settings (displayAppInformationRequiredState, displayLocationInformationRequiredState...).",
      "anyOf": [ { "type": "object" }, { "$ref": "#/$defs/expression" } ]
    },
    "isSoftwareOathEnabled": {
      "description": "microsoftAuthenticator: allow OTP codes from the Authenticator app.",
      "anyOf": [ { "type": "boolean" }, { "$ref": "#/$defs/expression" } ]
    },
    "isOfficePhoneAllowed": {
      "description": "voice: allow office phone numbers.",
      "anyOf": [ { "type": "boolean" }, { "$ref": "#/$defs/expression" } ]
    },
    "allowExternalIdToUseEmailOtp": {
      "description": "email: default, enabled or disabled.",
      "anyOf": [ { "type": "string", "enum": [ "default", "enabled", "disabled" ] }, { "$ref": "#/$defs/expression" } ]
    }
  },
  "additionalProperties": true,
  "$defs": {
    "expression": { "type": "string", "pattern": "^\\[.*\\]$", "description": "A template expression, for example [parameters('env')]." }
  },
  "x-earm": {
    "type": "Microsoft.Entra/authenticationMethodConfigurations",
    "parentType": null,
    "graphPath": "/policies/authenticationMethodsPolicy/authenticationMethodConfigurations",
    "apiVersions": { "2026-10-01-preview": "v1.0", "2026-10-01-preview.beta": "beta" },
    "nameMapsTo": "id",
    "nameKind": "id",
    "namePattern": "^(?i:fido2|temporaryAccessPass|x509Certificate|microsoftAuthenticator|sms|voice|email|softwareOath)$",
    "keyProperties": ["id"],
    "requiredOnCreate": [],
    "defaults": {},
    "immutable": [],
    "createOnly": [],
    "secure": [],
    "relationships": [],
    "memberKey": { "includeTargets": "id", "excludeTargets": "id", "passkeyProfiles": "id" },
    "stripOnRead": ["id"],
    "nullable": {},
    "permissions": {
      "application": ["Policy.ReadWrite.AuthenticationMethod"],
      "notes": "Learn (fido2authenticationmethodconfiguration-get/-update/-delete and the other method pages): Policy.ReadWrite.AuthenticationMethod is the least privileged permission for update and delete (delegated and application); reads need Policy.Read.AuthenticationMethod. Delegated callers need the Authentication Policy Administrator role (Global Reader suffices for reads).",
      "roles": ["Authentication Policy Administrator"]
    }
  }
}
