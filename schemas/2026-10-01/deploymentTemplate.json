{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.earm.proxylayer.net/schemas/2026-10-01/deploymentTemplate.json",
  "title": "EARM deployment template",
  "description": "ARM-style JSON template for Microsoft Entra ID resources under the Microsoft.Entra provider namespace (schema version 2026-10-01). Any string of the form \"[...]\" is a template expression; \"[[\" escapes a literal bracket.",
  "type": "object",
  "required": ["$schema", "contentVersion", "resources"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "The template schema: https://schema.earm.proxylayer.net/schemas/2026-10-01/deploymentTemplate.json#"
    },
    "languageVersion": {
      "type": "string",
      "description": "\"2.0\" enables symbolic resource names (resources as an object), existing resources, definitions (user-defined types) and the aggregate type constraints of parameters and outputs. Omit it (or \"1.0\") for the original language.",
      "examples": ["2.0"]
    },
    "contentVersion": {
      "type": "string",
      "description": "Version of the template, for example 1.0.0.0. Any string is accepted, as in ARM."
    },
    "metadata": {
      "type": "object",
      "description": "Free-form metadata about the template."
    },
    "definitions": {
      "type": "object",
      "description": "languageVersion 2.0: user-defined types, referenced with \"$ref\": \"#/definitions/<name>\".",
      "additionalProperties": { "$ref": "#/$defs/typeDefinition" }
    },
    "parameters": {
      "type": "object",
      "description": "Input values supplied at deployment time (parameter file, -p name=value, or defaultValue).",
      "additionalProperties": { "$ref": "#/$defs/parameter" }
    },
    "variables": {
      "type": "object",
      "description": "Named values computed once from parameters and other variables."
    },
    "functions": {
      "type": "array",
      "description": "User-defined functions grouped by namespace.",
      "items": { "$ref": "#/$defs/functionNamespace" }
    },
    "resources": {
      "description": "The Entra resources to deploy: an array, or with languageVersion 2.0 an object keyed by symbolic name.",
      "anyOf": [
        { "type": "array", "items": { "$ref": "#/$defs/resource" } },
        {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z0-9_]+$" },
          "additionalProperties": { "$ref": "#/$defs/resource" }
        }
      ]
    },
    "outputs": {
      "type": "object",
      "description": "Values returned after deployment.",
      "additionalProperties": { "$ref": "#/$defs/output" }
    }
  },
  "$defs": {
    "expression": {
      "type": "string",
      "pattern": "^\\[.*\\]$",
      "description": "A template expression, for example [parameters('env')]."
    },
    "boolOrExpression": {
      "anyOf": [ { "type": "boolean" }, { "$ref": "#/$defs/expression" } ]
    },
    "intOrExpression": {
      "anyOf": [ { "type": "integer" }, { "$ref": "#/$defs/expression" } ]
    },
    "objectOrExpression": {
      "anyOf": [ { "type": "object" }, { "$ref": "#/$defs/expression" } ]
    },
    "parameterType": {
      "type": "string",
      "description": "string, securestring, int, bool, object, secureObject or array; compared case-insensitively, as in ARM.",
      "anyOf": [
        { "enum": ["string", "securestring", "int", "bool", "object", "secureObject", "array"] },
        { "pattern": "^([Ss][Tt][Rr][Ii][Nn][Gg]|[Ss][Ee][Cc][Uu][Rr][Ee][Ss][Tt][Rr][Ii][Nn][Gg]|[Ii][Nn][Tt]|[Bb][Oo][Oo][Ll]|[Oo][Bb][Jj][Ee][Cc][Tt]|[Ss][Ee][Cc][Uu][Rr][Ee][Oo][Bb][Jj][Ee][Cc][Tt]|[Aa][Rr][Rr][Aa][Yy])$" }
      ]
    },
    "parameter": {
      "type": "object",
      "description": "A parameter: 'type' or (languageVersion 2.0) '$ref', with optional constraints.",
      "anyOf": [ { "required": ["type"] }, { "required": ["$ref"] } ],
      "properties": {
        "type": { "$ref": "#/$defs/parameterType" },
        "$ref": { "type": "string", "pattern": "^#/definitions/.+$", "description": "languageVersion 2.0: a user-defined type of 'definitions'." },
        "allowedValues": { "type": "array", "description": "The only values accepted." },
        "minValue": { "type": "integer", "description": "Minimum for int values. A literal integer: ARM allows expressions only in defaultValue." },
        "maxValue": { "type": "integer", "description": "Maximum for int values. A literal integer: ARM allows expressions only in defaultValue." },
        "minLength": { "type": "integer", "description": "Minimum length for string, securestring and array values. A literal integer: ARM allows expressions only in defaultValue." },
        "maxLength": { "type": "integer", "description": "Maximum length for string, securestring and array values. A literal integer: ARM allows expressions only in defaultValue." },
        "prefixItems": { "type": "array", "items": { "$ref": "#/$defs/typeDefinition" }, "description": "languageVersion 2.0: the type of the array element at the same index." },
        "items": { "anyOf": [ { "$ref": "#/$defs/typeDefinition" }, { "type": "boolean" } ], "description": "languageVersion 2.0: the type of the elements after prefixItems, or false for none." },
        "properties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/typeDefinition" }, "description": "languageVersion 2.0: the type of each object property; a property is required unless its type is nullable." },
        "additionalProperties": { "anyOf": [ { "$ref": "#/$defs/typeDefinition" }, { "type": "boolean" } ], "description": "languageVersion 2.0: the type of the properties not listed in 'properties', or false to refuse them." },
        "discriminator": { "$ref": "#/$defs/discriminator" },
        "sealed": { "type": "boolean", "description": "languageVersion 2.0 (Bicep): true refuses properties not listed in 'properties'." },
        "nullable": { "type": "boolean", "description": "languageVersion 2.0: the value may be null or omitted." },
        "metadata": { "type": "object", "description": "Free-form; 'description' is shown to users. Bicep markers such as __bicep_export! are accepted and ignored." },
        "defaultValue": { "description": "Value used when none is supplied. Secure parameters should not have one." }
      },
      "additionalProperties": false
    },
    "typeDefinition": {
      "type": "object",
      "description": "A type: 'type' or '$ref', with optional constraints (languageVersion 2.0 user-defined types and nested types).",
      "anyOf": [ { "required": ["type"] }, { "required": ["$ref"] } ],
      "properties": {
        "type": { "$ref": "#/$defs/parameterType" },
        "$ref": { "type": "string", "pattern": "^#/definitions/.+$", "description": "languageVersion 2.0: a user-defined type of 'definitions'." },
        "allowedValues": { "type": "array", "description": "The only values accepted." },
        "minValue": { "type": "integer", "description": "Minimum for int values. A literal integer: ARM allows expressions only in defaultValue." },
        "maxValue": { "type": "integer", "description": "Maximum for int values. A literal integer: ARM allows expressions only in defaultValue." },
        "minLength": { "type": "integer", "description": "Minimum length for string, securestring and array values. A literal integer: ARM allows expressions only in defaultValue." },
        "maxLength": { "type": "integer", "description": "Maximum length for string, securestring and array values. A literal integer: ARM allows expressions only in defaultValue." },
        "prefixItems": { "type": "array", "items": { "$ref": "#/$defs/typeDefinition" }, "description": "languageVersion 2.0: the type of the array element at the same index." },
        "items": { "anyOf": [ { "$ref": "#/$defs/typeDefinition" }, { "type": "boolean" } ], "description": "languageVersion 2.0: the type of the elements after prefixItems, or false for none." },
        "properties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/typeDefinition" }, "description": "languageVersion 2.0: the type of each object property; a property is required unless its type is nullable." },
        "additionalProperties": { "anyOf": [ { "$ref": "#/$defs/typeDefinition" }, { "type": "boolean" } ], "description": "languageVersion 2.0: the type of the properties not listed in 'properties', or false to refuse them." },
        "discriminator": { "$ref": "#/$defs/discriminator" },
        "sealed": { "type": "boolean", "description": "languageVersion 2.0 (Bicep): true refuses properties not listed in 'properties'." },
        "nullable": { "type": "boolean", "description": "languageVersion 2.0: the value may be null or omitted." },
        "metadata": { "type": "object", "description": "Free-form; 'description' is shown to users. Bicep markers such as __bicep_export! are accepted and ignored." }
      },
      "additionalProperties": false
    },
    "discriminator": {
      "type": "object",
      "description": "languageVersion 2.0: a tagged union; the value of 'propertyName' selects the object type in 'mapping'.",
      "required": ["propertyName", "mapping"],
      "properties": {
        "propertyName": { "type": "string" },
        "mapping": { "type": "object", "additionalProperties": { "$ref": "#/$defs/typeDefinition" } }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "description": "Declares 'value', or 'copy' (an output loop) instead of it; 'type' or (languageVersion 2.0) '$ref'.",
      "anyOf": [ { "required": ["type"] }, { "required": ["$ref"] } ],
      "properties": {
        "type": { "$ref": "#/$defs/parameterType" },
        "$ref": { "type": "string", "pattern": "^#/definitions/.+$", "description": "languageVersion 2.0: a user-defined type of 'definitions'." },
        "allowedValues": { "type": "array", "description": "The only values accepted." },
        "minValue": { "type": "integer", "description": "Minimum for int values. A literal integer: ARM allows expressions only in defaultValue." },
        "maxValue": { "type": "integer", "description": "Maximum for int values. A literal integer: ARM allows expressions only in defaultValue." },
        "minLength": { "type": "integer", "description": "Minimum length for string, securestring and array values. A literal integer: ARM allows expressions only in defaultValue." },
        "maxLength": { "type": "integer", "description": "Maximum length for string, securestring and array values. A literal integer: ARM allows expressions only in defaultValue." },
        "prefixItems": { "type": "array", "items": { "$ref": "#/$defs/typeDefinition" }, "description": "languageVersion 2.0: the type of the array element at the same index." },
        "items": { "anyOf": [ { "$ref": "#/$defs/typeDefinition" }, { "type": "boolean" } ], "description": "languageVersion 2.0: the type of the elements after prefixItems, or false for none." },
        "properties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/typeDefinition" }, "description": "languageVersion 2.0: the type of each object property; a property is required unless its type is nullable." },
        "additionalProperties": { "anyOf": [ { "$ref": "#/$defs/typeDefinition" }, { "type": "boolean" } ], "description": "languageVersion 2.0: the type of the properties not listed in 'properties', or false to refuse them." },
        "discriminator": { "$ref": "#/$defs/discriminator" },
        "sealed": { "type": "boolean", "description": "languageVersion 2.0 (Bicep): true refuses properties not listed in 'properties'." },
        "nullable": { "type": "boolean", "description": "languageVersion 2.0: the value may be null or omitted." },
        "metadata": { "type": "object", "description": "Free-form; 'description' is shown to users. Bicep markers such as __bicep_export! are accepted and ignored." },
        "value": { "description": "The output value; usually an expression. Not with 'copy'." },
        "copy": { "$ref": "#/$defs/outputCopy" },
        "condition": { "$ref": "#/$defs/boolOrExpression" }
      },
      "additionalProperties": false
    },
    "outputCopy": {
      "type": "object",
      "description": "Output iteration: the value is an array of 'count' elements, each built from 'input' with copyIndex() bound to its position.",
      "required": ["count", "input"],
      "properties": {
        "count": { "$ref": "#/$defs/intOrExpression" },
        "input": { "description": "The value of each element; copyIndex() is its position." }
      },
      "additionalProperties": false
    },
    "functionNamespace": {
      "type": "object",
      "required": ["namespace", "members"],
      "properties": {
        "namespace": { "type": "string", "description": "Prefix used to call the functions: namespace.function()." },
        "members": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/functionDefinition" }
        }
      },
      "additionalProperties": false
    },
    "functionDefinition": {
      "type": "object",
      "required": ["output"],
      "properties": {
        "metadata": { "type": "object" },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "anyOf": [ { "required": ["type"] }, { "required": ["$ref"] } ],
            "properties": {
              "name": { "type": "string" },
              "type": { "$ref": "#/$defs/parameterType" },
              "$ref": { "type": "string", "pattern": "^#/definitions/.+$" },
              "nullable": { "type": "boolean" },
              "metadata": { "type": "object" }
            },
            "additionalProperties": false
          }
        },
        "output": {
          "type": "object",
          "required": ["value"],
          "anyOf": [ { "required": ["type"] }, { "required": ["$ref"] } ],
          "properties": {
            "type": { "$ref": "#/$defs/parameterType" },
            "$ref": { "type": "string", "pattern": "^#/definitions/.+$" },
            "nullable": { "type": "boolean" },
            "metadata": { "type": "object" },
            "value": {}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "copy": {
      "type": "object",
      "required": ["name", "count"],
      "properties": {
        "name": { "type": "string", "description": "Loop name, used by copyIndex('name')." },
        "count": { "$ref": "#/$defs/intOrExpression" },
        "mode": {
          "anyOf": [ { "type": "string", "enum": ["serial", "parallel"] }, { "$ref": "#/$defs/expression" } ]
        },
        "batchSize": { "$ref": "#/$defs/intOrExpression" }
      },
      "additionalProperties": false
    },
    "dependsOn": {
      "type": "array",
      "description": "Resources that must be deployed first: a resource id, type/name, a unique bare name, or an expression.",
      "items": { "type": "string" }
    },
    "deploymentProperties": {
      "type": "object",
      "description": "The properties of a nested (inline template) or linked (templateLink) deployment. See docs/format.md, Nested and linked deployments.",
      "properties": {
        "mode": {
          "anyOf": [ { "type": "string", "enum": ["Incremental", "incremental"] }, { "$ref": "#/$defs/expression" } ],
          "description": "Incremental: the only mode of a nested or linked deployment (ARM rule)."
        },
        "template": { "type": "object", "description": "The inline nested template (validated when the deployment is expanded)." },
        "templateLink": {
          "type": "object",
          "description": "A linked template: relativePath (a file next to this template, or relative to its URL) or an https uri.",
          "properties": {
            "relativePath": { "type": "string" },
            "uri": { "type": "string" },
            "contentVersion": { "type": "string" },
            "queryString": { "type": "string" },
            "id": { "type": "string", "description": "A template spec: not supported." }
          }
        },
        "parameters": {
          "type": "object",
          "description": "Values for the parameters of an inner-scope or linked template: { \"name\": { \"value\": ... } }.",
          "additionalProperties": { "type": "object" }
        },
        "parametersLink": {
          "type": "object",
          "properties": { "uri": { "type": "string" }, "contentVersion": { "type": "string" } }
        },
        "expressionEvaluationOptions": {
          "type": "object",
          "properties": { "scope": { "type": "string", "enum": ["inner", "outer", "Inner", "Outer", "NotSpecified"] } }
        },
        "debugSetting": { "type": "object", "description": "Accepted and ignored." }
      }
    },
    "resource": {
      "type": "object",
      "required": ["type", "apiVersion", "name"],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^(Microsoft\\.Entra/[A-Za-z][A-Za-z0-9]*(/[A-Za-z][A-Za-z0-9]*)*|[Mm][Ii][Cc][Rr][Oo][Ss][Oo][Ff][Tt]\\.[Rr][Ee][Ss][Oo][Uu][Rr][Cc][Ee][Ss]/[Dd][Ee][Pp][Ll][Oo][Yy][Mm][Ee][Nn][Tt][Ss])$",
          "description": "Full resource type, for example Microsoft.Entra/applications; or Microsoft.Resources/deployments for a nested or linked deployment."
        },
        "apiVersion": {
          "type": "string",
          "enum": ["2026-10-01-preview", "2026-10-01-preview.beta", "2015-01-01", "2015-11-01", "2016-02-01", "2016-07-01", "2016-09-01", "2017-05-10", "2018-02-01", "2018-05-01", "2019-03-01", "2019-05-01", "2019-05-10", "2019-07-01", "2019-08-01", "2019-10-01", "2020-06-01", "2020-08-01", "2020-10-01", "2021-01-01", "2021-04-01", "2022-09-01", "2023-07-01", "2024-03-01", "2024-07-01", "2024-11-01", "2025-03-01", "2025-04-01", "2026-06-01"],
          "description": "2026-10-01-preview (Graph v1.0) or 2026-10-01-preview.beta (Graph beta, passthrough with no normalisation guarantees). The plain 2026-10-01 label was renamed 2026-10-01-preview. A Microsoft.Resources/deployments resource takes one of ARM's apiVersions (any of them; the value changes nothing)."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "The ARM-style key of the resource; parent/child for child types."
        },
        "properties": { "$ref": "#/$defs/objectOrExpression" },
        "dependsOn": { "$ref": "#/$defs/dependsOn" },
        "condition": { "$ref": "#/$defs/boolOrExpression" },
        "copy": { "$ref": "#/$defs/copy" },
        "comments": { "type": "string" },
        "metadata": { "type": "object" },
        "existing": { "type": "boolean", "description": "languageVersion 2.0: true reads an existing resource instead of deploying it; only type, apiVersion and name are needed." },
        "resources": {
          "type": "array",
          "description": "Nested child resources (short type and name).",
          "items": { "$ref": "#/$defs/childResource" }
        }
      },
      "additionalProperties": false,
      "allOf": [
        { "if": { "properties": { "type": { "type": "string", "pattern": "^[Mm][Ii][Cc][Rr][Oo][Ss][Oo][Ff][Tt]\\.[Rr][Ee][Ss][Oo][Uu][Rr][Cc][Ee][Ss]/[Dd][Ee][Pp][Ll][Oo][Yy][Mm][Ee][Nn][Tt][Ss]$" } }, "required": ["type"] },
          "then": { "required": ["properties"], "properties": { "properties": { "anyOf": [ { "$ref": "#/$defs/deploymentProperties" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/applications" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/applications.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/applications/federatedIdentityCredentials" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/applications.federatedIdentityCredentials.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/applications/passwordCredentials" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/applications.passwordCredentials.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/servicePrincipals" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/servicePrincipals.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/groups" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/groups.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/users" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/users.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/roleDefinitions" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/roleDefinitions.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/conditionalAccess/authenticationContextClassReferences" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/conditionalAccess.authenticationContextClassReferences.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/conditionalAccess/authenticationStrengths" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/conditionalAccess.authenticationStrengths.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/appRoleAssignments" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/appRoleAssignments.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/oauth2PermissionGrants" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/oauth2PermissionGrants.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/conditionalAccess/namedLocations" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/conditionalAccess.namedLocations.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/conditionalAccess/policies" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/conditionalAccess.policies.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/administrativeUnits" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/administrativeUnits.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/roleAssignments" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/roleAssignments.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/authenticationMethodConfigurations" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/authenticationMethodConfigurations.json" }, { "$ref": "#/$defs/expression" } ] } } } },
