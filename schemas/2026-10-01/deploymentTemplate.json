{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.earm.proxylayer.net/schemas/2026-10-01/deploymentTemplate.json",
  "title": "EARM deployment template",
  "description": "ARM-style JSON template for Microsoft Entra ID resources under the Microsoft.Entra provider namespace (schema version 2026-10-01). Any string of the form \"[...]\" is a template expression; \"[[\" escapes a literal bracket.",
  "type": "object",
  "required": ["$schema", "contentVersion", "resources"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "The template schema: https://schema.earm.proxylayer.net/schemas/2026-10-01/deploymentTemplate.json#"
    },
    "contentVersion": {
      "type": "string",
      "description": "Version of the template in the form major.minor.build.revision, for example 1.0.0.0."
    },
    "metadata": {
      "type": "object",
      "description": "Free-form metadata about the template."
    },
    "parameters": {
      "type": "object",
      "description": "Input values supplied at deployment time (parameter file, -p name=value, or defaultValue).",
      "additionalProperties": { "$ref": "#/$defs/parameter" }
    },
    "variables": {
      "type": "object",
      "description": "Named values computed once from parameters and other variables."
    },
    "functions": {
      "type": "array",
      "description": "User-defined functions grouped by namespace.",
      "items": { "$ref": "#/$defs/functionNamespace" }
    },
    "resources": {
      "type": "array",
      "description": "The Entra resources to deploy.",
      "items": { "$ref": "#/$defs/resource" }
    },
    "outputs": {
      "type": "object",
      "description": "Values returned after deployment.",
      "additionalProperties": { "$ref": "#/$defs/output" }
    }
  },
  "$defs": {
    "expression": {
      "type": "string",
      "pattern": "^\\[.*\\]$",
      "description": "A template expression, for example [parameters('env')]."
    },
    "boolOrExpression": {
      "anyOf": [ { "type": "boolean" }, { "$ref": "#/$defs/expression" } ]
    },
    "intOrExpression": {
      "anyOf": [ { "type": "integer" }, { "$ref": "#/$defs/expression" } ]
    },
    "objectOrExpression": {
      "anyOf": [ { "type": "object" }, { "$ref": "#/$defs/expression" } ]
    },
    "parameterType": {
      "type": "string",
      "enum": ["string", "securestring", "int", "bool", "object", "secureObject", "array"]
    },
    "parameter": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "$ref": "#/$defs/parameterType" },
        "defaultValue": { "description": "Value used when none is supplied. Secure parameters should not have one." },
        "allowedValues": { "type": "array", "description": "The only values the parameter accepts." },
        "minValue": { "type": "integer", "description": "Minimum for int parameters. A literal integer: ARM allows expressions only in defaultValue." },
        "maxValue": { "type": "integer", "description": "Maximum for int parameters. A literal integer: ARM allows expressions only in defaultValue." },
        "minLength": { "type": "integer", "description": "Minimum length for string, securestring and array parameters. A literal integer: ARM allows expressions only in defaultValue." },
        "maxLength": { "type": "integer", "description": "Maximum length for string, securestring and array parameters. A literal integer: ARM allows expressions only in defaultValue." },
        "metadata": { "type": "object", "properties": { "description": { "type": "string" } } }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["type"],
      "description": "Declares 'value', or 'copy' (an output loop) instead of it.",
      "properties": {
        "type": { "$ref": "#/$defs/parameterType" },
        "value": { "description": "The output value; usually an expression. Not with 'copy'." },
        "copy": { "$ref": "#/$defs/outputCopy" },
        "condition": { "$ref": "#/$defs/boolOrExpression" },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "outputCopy": {
      "type": "object",
      "description": "Output iteration: the value is an array of 'count' elements, each built from 'input' with copyIndex() bound to its position.",
      "required": ["count", "input"],
      "properties": {
        "count": { "$ref": "#/$defs/intOrExpression" },
        "input": { "description": "The value of each element; copyIndex() is its position." }
      },
      "additionalProperties": false
    },
    "functionNamespace": {
      "type": "object",
      "required": ["namespace", "members"],
      "properties": {
        "namespace": { "type": "string", "description": "Prefix used to call the functions: namespace.function()." },
        "members": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/functionDefinition" }
        }
      },
      "additionalProperties": false
    },
    "functionDefinition": {
      "type": "object",
      "required": ["output"],
      "properties": {
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string" },
              "type": { "$ref": "#/$defs/parameterType" }
            },
            "additionalProperties": false
          }
        },
        "output": {
          "type": "object",
          "required": ["type", "value"],
          "properties": {
            "type": { "$ref": "#/$defs/parameterType" },
            "value": {}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "copy": {
      "type": "object",
      "required": ["name", "count"],
      "properties": {
        "name": { "type": "string", "description": "Loop name, used by copyIndex('name')." },
        "count": { "$ref": "#/$defs/intOrExpression" },
        "mode": {
          "anyOf": [ { "type": "string", "enum": ["serial", "parallel"] }, { "$ref": "#/$defs/expression" } ]
        },
        "batchSize": { "$ref": "#/$defs/intOrExpression" }
      },
      "additionalProperties": false
    },
    "dependsOn": {
      "type": "array",
      "description": "Resources that must be deployed first: a resource id, type/name, a unique bare name, or an expression.",
      "items": { "type": "string" }
    },
    "resource": {
      "type": "object",
      "required": ["type", "apiVersion", "name"],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^Microsoft\\.Entra/[A-Za-z][A-Za-z0-9]*(/[A-Za-z][A-Za-z0-9]*)*$",
          "description": "Full resource type, for example Microsoft.Entra/applications."
        },
        "apiVersion": {
          "type": "string",
          "enum": ["2026-10-01-preview", "2026-10-01-preview.beta"],
          "description": "2026-10-01-preview (Graph v1.0) or 2026-10-01-preview.beta (Graph beta, passthrough with no normalisation guarantees). The plain 2026-10-01 label was renamed 2026-10-01-preview."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "The ARM-style key of the resource; parent/child for child types."
        },
        "properties": { "$ref": "#/$defs/objectOrExpression" },
        "dependsOn": { "$ref": "#/$defs/dependsOn" },
        "condition": { "$ref": "#/$defs/boolOrExpression" },
        "copy": { "$ref": "#/$defs/copy" },
        "comments": { "type": "string" },
        "metadata": { "type": "object" },
        "resources": {
          "type": "array",
          "description": "Nested child resources (short type and name).",
          "items": { "$ref": "#/$defs/childResource" }
        }
      },
      "additionalProperties": false,
      "allOf": [
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/applications" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/applications.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/applications/federatedIdentityCredentials" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/applications.federatedIdentityCredentials.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/applications/passwordCredentials" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/applications.passwordCredentials.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/servicePrincipals" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/servicePrincipals.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/groups" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/groups.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/users" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/users.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/roleDefinitions" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/roleDefinitions.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/conditionalAccess/authenticationContextClassReferences" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/conditionalAccess.authenticationContextClassReferences.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/conditionalAccess/authenticationStrengths" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/conditionalAccess.authenticationStrengths.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/appRoleAssignments" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/appRoleAssignments.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/oauth2PermissionGrants" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/oauth2PermissionGrants.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/conditionalAccess/namedLocations" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/conditionalAccess.namedLocations.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/conditionalAccess/policies" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/conditionalAccess.policies.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/administrativeUnits" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/administrativeUnits.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/roleAssignments" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/roleAssignments.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/authenticationMethodConfigurations" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/authenticationMethodConfigurations.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/roleEligibilityScheduleRequests" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/roleEligibilityScheduleRequests.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/privilegedAccess/groupEligibilityScheduleRequests" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/privilegedAccess.groupEligibilityScheduleRequests.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/roleAssignmentScheduleRequests" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/roleAssignmentScheduleRequests.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/privilegedAccess/groupAssignmentScheduleRequests" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/privilegedAccess.groupAssignmentScheduleRequests.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/roleManagementPolicies" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/roleManagementPolicies.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/entitlementManagement/catalogs" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/entitlementManagement.catalogs.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/entitlementManagement/catalogResources" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/entitlementManagement.catalogResources.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/entitlementManagement/accessPackages" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/entitlementManagement.accessPackages.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/entitlementManagement/resourceRoleScopes" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/entitlementManagement.resourceRoleScopes.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "const": "Microsoft.Entra/entitlementManagement/accessPackages/assignmentPolicies" } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/entitlementManagement.accessPackages.assignmentPolicies.json" }, { "$ref": "#/$defs/expression" } ] } } } }
      ]
    },
    "childResource": {
      "type": "object",
      "required": ["type", "apiVersion", "name"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Short child type (federatedIdentityCredentials, passwordCredentials) or the full type."
        },
        "apiVersion": {
          "type": "string",
          "enum": ["2026-10-01-preview", "2026-10-01-preview.beta"],
          "description": "2026-10-01-preview (Graph v1.0) or 2026-10-01-preview.beta (Graph beta)."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "The child's own name; the parent's name is prepended automatically."
        },
        "properties": { "$ref": "#/$defs/objectOrExpression" },
        "dependsOn": { "$ref": "#/$defs/dependsOn" },
        "condition": { "$ref": "#/$defs/boolOrExpression" },
        "copy": { "$ref": "#/$defs/copy" },
        "comments": { "type": "string" },
        "metadata": { "type": "object" },
        "resources": {
          "type": "array",
          "maxItems": 0,
          "description": "Nesting deeper than two levels is not supported; declare deeper children at the top level."
        }
      },
      "additionalProperties": false,
      "allOf": [
        { "if": { "properties": { "type": { "enum": ["federatedIdentityCredentials", "Microsoft.Entra/applications/federatedIdentityCredentials"] } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/applications.federatedIdentityCredentials.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "enum": ["passwordCredentials", "Microsoft.Entra/applications/passwordCredentials"] } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/applications.passwordCredentials.json" }, { "$ref": "#/$defs/expression" } ] } } } },
        { "if": { "properties": { "type": { "enum": ["assignmentPolicies", "Microsoft.Entra/entitlementManagement/accessPackages/assignmentPolicies"] } }, "required": ["type"] },
          "then": { "properties": { "properties": { "anyOf": [ { "$ref": "https://schema.earm.proxylayer.net/schemas/2026-10-01/types/Microsoft.Entra/entitlementManagement.accessPackages.assignmentPolicies.json" }, { "$ref": "#/$defs/expression" } ] } } } }
      ]
    }
  }
}
