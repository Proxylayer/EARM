<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Every production assembly exposes its internals to the test assemblies. -->
  <ItemGroup>
    <InternalsVisibleTo Include="EArm.Tests" />
    <InternalsVisibleTo Include="EArm.Az.Tests" />
    <InternalsVisibleTo Include="EArm.Providers.Tests" />
    <InternalsVisibleTo Include="EArm.Integration.Tests" />
  </ItemGroup>

</Project>
