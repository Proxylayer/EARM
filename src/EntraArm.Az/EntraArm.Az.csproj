<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>EntraARM Azure CLI integration: PowerShell-hosted az runner, Microsoft Graph client, retry and error mapping.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
