{
  "$schema": "https://entraarm.dev/schemas/2026-10-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "A web application registration with its service principal, a GitHub Actions federated credential and a rotating client secret. Deploy with: entraarm deployment create -f samples/app-with-sp-and-secret.entra.json -p @samples/app-with-sp-and-secret.parameters.json --secure-outputs-file ./secrets.json"
  },
  "parameters": {
    "env":        { "type": "string", "allowedValues": ["dev", "prod"], "metadata": { "description": "Environment; part of every name." } },
    "githubOrg":  { "type": "string", "metadata": { "description": "GitHub organisation allowed to request tokens for the application." } },
    "githubRepo": { "type": "string", "metadata": { "description": "GitHub repository (without the organisation)." } },
    "secretTag":  { "type": "string", "defaultValue": "2026Q4", "metadata": { "description": "Change this value to rotate the client secret." } }
  },
  "variables": {
    "appName":    "[format('contoso-{0}-web', parameters('env'))]",
    "graphAppId": "[wellKnownApp('MicrosoftGraph')]",
    "redirectUri": "[format('https://web-{0}.contoso.com/signin-oidc', parameters('env'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Entra/applications",
      "apiVersion": "2026-10-01",
      "name": "[variables('appName')]",
      "comments": "The name is the Graph uniqueName: a rerun updates this application, it never creates a second one.",
      "properties": {
        "displayName": "[format('Contoso Web ({0})', parameters('env'))]",
        "signInAudience": "AzureADMyOrg",
        "identifierUris": ["[format('api://{0}', variables('appName'))]"],
        "web": {
          "redirectUris": ["[variables('redirectUri')]"],
          "logoutUrl": "[format('https://web-{0}.contoso.com/signout-oidc', parameters('env'))]",
          "implicitGrantSettings": { "enableAccessTokenIssuance": false, "enableIdTokenIssuance": false }
        },
        "api": {
          "requestedAccessTokenVersion": 2,
          "oauth2PermissionScopes": [
            {
              "id": "9b2f6c4e-5a33-4d3b-8f0e-2c0d6a1e7b01",
              "value": "Reports.Read",
              "type": "User",
              "isEnabled": true,
              "adminConsentDisplayName": "Read reports",
              "adminConsentDescription": "Allows the application to read reports on behalf of the signed-in user."
            }
          ]
        },
        "appRoles": [
          {
            "id": "9b2f6c4e-5a33-4d3b-8f0e-2c0d6a1e7b02",
            "value": "Reports.Admin",
            "displayName": "Reports administrator",
            "description": "Manage all reports.",
            "allowedMemberTypes": ["User", "Application"],
            "isEnabled": true
          }
        ],
        "requiredResourceAccess": [
          {
            "resourceAppId": "[variables('graphAppId')]",
            "resourceAccess": [
              { "id": "[permissionScope(variables('graphAppId'), 'User.Read')]", "type": "Scope" }
            ]
          }
        ],
        "tags": ["contoso", "web"]
      },
      "resources": [
        {
          "type": "federatedIdentityCredentials",
          "apiVersion": "2026-10-01",
          "name": "github-main",
          "properties": {
            "issuer": "https://token.actions.githubusercontent.com",
            "subject": "[format('repo:{0}/{1}:ref:refs/heads/main', parameters('githubOrg'), parameters('githubRepo'))]",
            "audiences": ["api://AzureADTokenExchange"],
            "description": "Deployments from the main branch"
          }
        },
        {
          "type": "passwordCredentials",
          "apiVersion": "2026-10-01",
          "name": "ci-secret",
          "comments": "endDateTime is left out: the secret expires 180 days after creation. It is replaced when rotationTag changes or fewer than rotateBeforeDays remain.",
          "properties": {
            "rotationTag": "[parameters('secretTag')]",
            "rotateBeforeDays": 30
          }
        }
      ]
    },
    {
      "type": "Microsoft.Entra/servicePrincipals",
      "apiVersion": "2026-10-01",
      "name": "[reference(variables('appName')).appId]",
      "comments": "Named after the application's appId, so it is created after the application and is implicitly dependent on it.",
      "properties": {
        "appRoleAssignmentRequired": true,
        "tags": ["WindowsAzureActiveDirectoryIntegratedApp"]
      }
    }
  ],
  "outputs": {
    "appId": {
      "type": "string",
      "value": "[reference(variables('appName')).appId]"
    },
    "servicePrincipalObjectId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Entra/servicePrincipals', reference(variables('appName')).appId)).id]"
    },
    "tenantId": {
      "type": "string",
      "value": "[tenant().tenantId]"
    },
    "clientSecret": {
      "type": "securestring",
      "value": "[reference(resourceId('Microsoft.Entra/applications/passwordCredentials', variables('appName'), 'ci-secret')).secretText]"
    }
  }
}
