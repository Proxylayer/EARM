{
  "$schema": "https://schema.earm.proxylayer.net/schemas/2026-10-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Tenant security baseline: trusted locations, a phishing-resistant authentication strength, an authentication context, two Conditional Access policies (report-only), a role-assignable admin group holding directory roles, a custom directory role and an administrative unit. Needs Entra ID P1 and Privileged Role Administrator rights; see docs/permissions.md."
  },
  "parameters": {
    "env":            { "type": "string", "allowedValues": ["dev", "prod"], "metadata": { "description": "Environment; part of every name." } },
    "officeCidrs":    { "type": "array", "metadata": { "description": "Office IP ranges in CIDR notation (host bits must be zero)." } },
    "adminObjectIds": { "type": "array", "defaultValue": [], "metadata": { "description": "Object ids of the users that are members of the admin group (the declared set is authoritative)." } }
  },
  "variables": {
    "prefix":      "[format('contoso-{0}', parameters('env'))]",
    "adminsName":  "[format('{0}-security-admins', variables('prefix'))]",
    "breakGlass":  "[format('{0}-break-glass', variables('prefix'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Entra/conditionalAccess/namedLocations",
      "apiVersion": "2026-10-01-preview",
      "name": "Contoso offices",
      "properties": {
        "@odata.type": "#microsoft.graph.ipNamedLocation",
        "isTrusted": true,
        "ipRanges": "[map(parameters('officeCidrs'), lambda('c', createObject('cidrAddress', lambdaVariables('c'))))]"
      }
    },
    {
      "type": "Microsoft.Entra/conditionalAccess/namedLocations",
      "apiVersion": "2026-10-01-preview",
      "name": "Allowed countries",
      "properties": {
        "@odata.type": "#microsoft.graph.countryNamedLocation",
        "countriesAndRegions": ["GB", "IE"],
        "includeUnknownCountriesAndRegions": false,
        "countryLookupMethod": "clientIpAddress"
      }
    },
    {
      "type": "Microsoft.Entra/conditionalAccess/authenticationStrengths",
      "apiVersion": "2026-10-01-preview",
      "name": "Admin phishing-resistant",
      "properties": {
        "description": "FIDO2 security key or Windows Hello for Business only",
        "allowedCombinations": ["fido2", "windowsHelloForBusiness"]
      }
    },
    {
      "type": "Microsoft.Entra/conditionalAccess/authenticationContextClassReferences",
      "apiVersion": "2026-10-01-preview",
      "name": "c10",
      "properties": {
        "displayName": "Sensitive actions",
        "description": "Step-up for refunds and role changes",
        "isAvailable": true
      }
    },
    {
      "type": "Microsoft.Entra/roleDefinitions",
      "apiVersion": "2026-10-01-preview",
      "name": "Security Policy Reviewer",
      "properties": {
        "description": "Read conditional access policies and named locations",
        "isEnabled": true,
        "rolePermissions": [
          {
            "allowedResourceActions": [
              "microsoft.directory/conditionalAccessPolicies/standard/read",
              "microsoft.directory/namedLocations/standard/read"
            ]
          }
        ]
      }
    },
    {
      "type": "Microsoft.Entra/administrativeUnits",
      "apiVersion": "2026-10-01-preview",
      "name": "Security AU",
      "properties": {
        "description": "Scope for delegated user administration",
        "isMemberManagementRestricted": false
      }
    },
    {
      "type": "Microsoft.Entra/groups",
      "apiVersion": "2026-10-01-preview",
      "name": "[variables('breakGlass')]",
      "comments": "Excluded from every policy below so an outage of the policies can never lock the tenant out. Add the emergency-access accounts here.",
      "properties": {
        "displayName": "Break glass accounts",
        "mailEnabled": false,
        "mailNickname": "break-glass",
        "securityEnabled": true,
        "description": "Emergency access accounts, excluded from Conditional Access"
      }
    },
    {
      "type": "Microsoft.Entra/groups",
      "apiVersion": "2026-10-01-preview",
      "name": "[variables('adminsName')]",
      "comments": "Role-assignable groups are immutable in that respect and limited to 500 per tenant; directoryRoles is only allowed on such a group.",
      "properties": {
        "displayName": "Security administrators",
        "mailEnabled": false,
        "mailNickname": "security-admins",
        "securityEnabled": true,
        "isAssignableToRole": true,
        "members": "[parameters('adminObjectIds')]",
        "directoryRoles": [
          { "role": "Security Reader" },
          { "role": "[reference('Security Policy Reviewer').id]", "directoryScopeId": "/" },
          { "role": "User Administrator", "administrativeUnit": "[reference('Security AU').id]" }
        ]
      }
    },
    {
      "type": "Microsoft.Entra/conditionalAccess/policies",
      "apiVersion": "2026-10-01-preview",
      "name": "CA-Admins-PhishingResistant",
      "properties": {
        "state": "enabledForReportingButNotEnforced",
        "conditions": {
          "clientAppTypes": ["all"],
          "users": {
            "includeGroups": ["[reference(variables('adminsName')).id]"],
            "excludeGroups": ["[reference(variables('breakGlass')).id]"]
          },
          "applications": { "includeApplications": ["All"] },
          "locations": {
            "includeLocations": ["All"],
            "excludeLocations": ["[reference('Contoso offices').id]"]
          }
        },
        "grantControls": {
          "operator": "OR",
          "authenticationStrength": { "id": "[reference('Admin phishing-resistant').id]" }
        }
      }
    },
    {
      "type": "Microsoft.Entra/conditionalAccess/policies",
      "apiVersion": "2026-10-01-preview",
      "name": "CA-SensitiveActions-StepUp",
      "properties": {
        "state": "enabledForReportingButNotEnforced",
        "conditions": {
          "clientAppTypes": ["all"],
          "users": {
            "includeUsers": ["All"],
            "excludeGroups": ["[reference(variables('breakGlass')).id]"]
          },
          "applications": {
            "includeAuthenticationContextClassReferences": ["[reference(resourceId('Microsoft.Entra/conditionalAccess/authenticationContextClassReferences', 'c10')).id]"]
          }
        },
        "grantControls": { "operator": "OR", "builtInControls": ["mfa"] }
      }
    }
  ],
  "outputs": {
    "adminsGroupId": {
      "type": "string",
      "value": "[reference(variables('adminsName')).id]"
    },
    "customRoleId": {
      "type": "string",
      "value": "[reference('Security Policy Reviewer').id]"
    },
    "stepUpContextId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Entra/conditionalAccess/authenticationContextClassReferences', 'c10')).id]"
    }
  }
}
