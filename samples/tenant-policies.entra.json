{
  "$schema": "https://schema.earm.proxylayer.net/schemas/2026-10-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Tenant policies: a Microsoft 365 group expiration policy limited to the groups that opt in (managedGroupTypes Selected) with one team joining it through its groupLifecyclePolicies edge. Every policy here is tenant-wide; read docs/providers.md before deploying it to a tenant people use."
  },
  "parameters": {
    "groupLifetimeInDays": { "type": "int", "defaultValue": 180, "metadata": { "description": "Days until a governed Microsoft 365 group expires unless renewed." } },
    "expiryNotificationEmails": { "type": "string", "metadata": { "description": "Semicolon-separated addresses notified about groups without owners." } },
    "accessTokenLifetime": { "type": "string", "defaultValue": "02:00:00", "metadata": { "description": "Access token lifetime of the portal (10 minutes to 1 day, hh:mm:ss)." } }
  },
  "resources": [
    {
      "type": "Microsoft.Entra/groupLifecyclePolicies",
      "apiVersion": "2026-10-01-preview",
      "name": "default",
      "properties": {
        "groupLifetimeInDays": "[parameters('groupLifetimeInDays')]",
        "managedGroupTypes": "Selected",
        "alternateNotificationEmails": "[parameters('expiryNotificationEmails')]"
      }
    },
    {
      "type": "Microsoft.Entra/groups",
      "apiVersion": "2026-10-01-preview",
      "name": "team-sales-emea",
      "properties": {
        "displayName": "Sales EMEA",
        "groupTypes": [ "Unified" ],
        "mailEnabled": true,
        "securityEnabled": false,
        "mailNickname": "sales-emea",
        "visibility": "Private",
        "groupLifecyclePolicies": [ "[reference(resourceId('Microsoft.Entra/groupLifecyclePolicies', 'default')).id]" ]
      }
    },
    {
      "type": "Microsoft.Entra/policies/tokenLifetimePolicies",
      "apiVersion": "2026-10-01-preview",
      "name": "Portal access tokens (2h)",
      "properties": {
        "definition": [ { "TokenLifetimePolicy": { "Version": 1, "AccessTokenLifetime": "[parameters('accessTokenLifetime')]" } } ]
      }
    },
    {
      "type": "Microsoft.Entra/applications",
      "apiVersion": "2026-10-01-preview",
      "name": "contoso-portal",
      "properties": {
        "displayName": "Contoso portal",
        "signInAudience": "AzureADMyOrg",
        "tokenLifetimePolicies": [ "[reference('Portal access tokens (2h)').id]" ],
        "appManagementPolicies": [ "[reference('Portal secrets (30 days)').id]" ]
      }
    },
    {
      "type": "Microsoft.Entra/policies/claimsMappingPolicies",
      "apiVersion": "2026-10-01-preview",
      "name": "Portal employee id claim",
      "properties": {
        "definition": [
          {
            "ClaimsMappingPolicy": {
              "Version": 1,
              "IncludeBasicClaimSet": "true",
              "ClaimsSchema": [ { "Source": "user", "ID": "employeeid", "SamlClaimType": "http://schemas.contoso.com/identity/claims/employeeid", "JwtClaimType": "employeeid" } ]
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Entra/servicePrincipals",
      "apiVersion": "2026-10-01-preview",
      "name": "[reference('contoso-portal').appId]",
      "dependsOn": [ "[resourceId('Microsoft.Entra/applications', 'contoso-portal')]" ],
      "properties": {
        "claimsMappingPolicies": [ "[reference('Portal employee id claim').id]" ]
      }
    },
    {
      "type": "Microsoft.Entra/policies/defaultAppManagementPolicy",
      "apiVersion": "2026-10-01-preview",
      "name": "default",
      "properties": {
        "isEnabled": true,
        "applicationRestrictions": {
          "passwordCredentials": [
            { "restrictionType": "passwordLifetime", "state": "enabled", "maxLifetime": "P180D", "restrictForAppsCreatedAfterDateTime": "2025-01-01T00:00:00Z" }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Entra/policies/appManagementPolicies",
      "apiVersion": "2026-10-01-preview",
      "name": "Portal secrets (30 days)",
      "properties": {
        "description": "Client secrets of the portal expire within 30 days.",
        "isEnabled": true,
        "restrictions": {
          "passwordCredentials": [
            { "restrictionType": "passwordLifetime", "state": "enabled", "maxLifetime": "P30D", "restrictForAppsCreatedAfterDateTime": "2025-01-01T00:00:00Z" }
          ]
        }
      }
    }
  ]
}
