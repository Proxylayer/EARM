# ---- .NET build and test output ----
bin/
obj/
artifacts/
TestResults/
coverage/
*.cobertura.xml
*.nupkg
*.snupkg
*.user
*.suo

# ---- IDEs and editors ----
# .vscode/ is ignored here on purpose: `earm schema install` writes .vscode/settings.json into the
# user's own workspace, never into this repository.
.vs/
.vscode/
.idea/
*.swp

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- EARM runtime ----
# State files (.earm/state/<name>.json, ids and hashes only) are safe to commit in a user's repository,
# but this repository holds no real deployments: anything a local run writes here is scratch.
.earm/
*.entrastate.json
**/state/*.lock
**/state/*.previous
*.earm.bak
.earm.bak
deployment.lock

# The file `deployment create --secure-outputs-file` writes holds client secrets and generated passwords in clear text (owner-only
# permissions, but a git add does not care). The docs and samples use ./secure-outputs.json; every plausible spelling is ignored.
secrets.json
secure-outputs*.json
*secure*output*.json
*.secrets.json
# The rotated copy and the cross-process lock the secure-outputs writer keeps next to the file (secure-outputs.json.previous / .lock) hold the same secrets.
secure-outputs*.json.previous
secure-outputs*.json.lock
secrets.json.previous
secrets.json.lock
*.previous

# ---- Secrets hygiene ----
*.pfx
*.pem
*.key
*.snk
.env
.env.*
!.env.example
appsettings.local.json
appsettings*.local.json
launchSettings.json

# ---- Debug traces (a developer's scratch output, never part of the repository) ----
trace*.txt

# ---- Claude Code / agent tooling (local only, never committed) ----
.claude/
