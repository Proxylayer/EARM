# ---- .NET build and test output ----
bin/
obj/
artifacts/
TestResults/
coverage/
*.cobertura.xml
*.nupkg
*.snupkg
*.user
*.suo

# ---- IDEs and editors ----
# .vscode/ is ignored here on purpose: `earm schema install` writes .vscode/settings.json into the
# user's own workspace, never into this repository.
.vs/
.vscode/
.idea/
*.swp

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- EARM runtime ----
# State files (.earm/state/<name>.json, ids and hashes only) are safe to commit in a user's repository,
# but this repository holds no real deployments: anything a local run writes here is scratch.
.earm/
*.entrastate.json
secure-outputs*.json
**/state/*.lock

# ---- Secrets hygiene ----
*.pfx
*.pem
*.key
.env
.env.*
!.env.example
*.secrets.json
appsettings.*.local.json

# ---- Claude Code / agent tooling (local only, never committed) ----
.claude/
