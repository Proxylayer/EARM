<Project>

  <!-- Shared settings for every project in the repository (src/ and tests/ add their own on top). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Code rule: no implicit usings anywhere; every file carries explicit using directives. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- .editorconfig style rules (file-scoped namespaces, using placement, braces, accessibility, naming) are enforced by the compiler build, as errors with
         TreatWarningsAsErrors. AnalysisMode stays Default: Recommended adds ~2,600 CA warnings (mostly CA1707 on xunit test names, then CA1859/CA1861 perf hints). -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisMode>Default</AnalysisMode>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Deterministic, reproducible builds. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Version and package metadata. -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Product>EARM</Product>
    <Authors>EARM</Authors>
    <Company>EARM</Company>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

</Project>
