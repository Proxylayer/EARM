{
  "$schema": "https://entraarm.dev/schemas/2026-10-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "WI-19: a custom role, an administrative unit and a role-assignable group holding Directory Readers at tenant scope (directoryRoles edge), a built-in role at AU scope (edge) and the custom role at AU scope (standalone roleAssignments resource)."
  },
  "parameters": {
    "prefix": { "type": "string" }
  },
  "variables": {
    "role":  "[format('{0}-role', parameters('prefix'))]",
    "unit":  "[format('{0}-au', parameters('prefix'))]",
    "group": "[format('{0}-rgrp', parameters('prefix'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Entra/roleDefinitions",
      "apiVersion": "2026-10-01",
      "name": "[variables('role')]",
      "properties": {
        "description": "EntraARM integration test role",
        "isEnabled": true,
        "rolePermissions": [
          {
            "allowedResourceActions": [
              "microsoft.directory/users/password/update",
              "microsoft.directory/users/standard/read"
            ]
          }
        ]
      }
    },
    {
      "type": "Microsoft.Entra/administrativeUnits",
      "apiVersion": "2026-10-01",
      "name": "[variables('unit')]",
      "properties": {
        "description": "EntraARM integration test administrative unit"
      }
    },
    {
      "type": "Microsoft.Entra/groups",
      "apiVersion": "2026-10-01",
      "name": "[variables('group')]",
      "properties": {
        "displayName": "[variables('group')]",
        "mailEnabled": false,
        "mailNickname": "[variables('group')]",
        "securityEnabled": true,
        "isAssignableToRole": true,
        "directoryRoles": [
          { "role": "Directory Readers" },
          { "role": "User Administrator", "administrativeUnit": "[reference(variables('unit')).id]" }
        ]
      }
    },
    {
      "type": "Microsoft.Entra/roleAssignments",
      "apiVersion": "2026-10-01",
      "name": "[guid(parameters('prefix'), 'custom-role-at-au')]",
      "properties": {
        "roleDefinitionId": "[reference(variables('role')).id]",
        "principalId": "[reference(variables('group')).id]",
        "directoryScopeId": "[format('/administrativeUnits/{0}', reference(variables('unit')).id)]"
      }
    }
  ],
  "outputs": {
    "roleId":  { "type": "string", "value": "[reference(variables('role')).id]" },
    "unitId":  { "type": "string", "value": "[reference(variables('unit')).id]" },
    "groupId": { "type": "string", "value": "[reference(variables('group')).id]" }
  }
}
