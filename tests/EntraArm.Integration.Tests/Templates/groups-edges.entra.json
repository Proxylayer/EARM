{
  "$schema": "https://entraarm.dev/schemas/2026-10-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "WI-19: membership and ownership edges declared from both sides. ga: target side (members, owners). gb: principal side (memberOf gc). u2: principal side (memberOf gc, ownerOf gb)."
  },
  "parameters": {
    "prefix":     { "type": "string" },
    "domain":     { "type": "string" },
    "u2Password": { "type": "securestring" }
  },
  "variables": {
    "u1": "[format('{0}-u1@{1}', parameters('prefix'), parameters('domain'))]",
    "u2": "[format('{0}-u2@{1}', parameters('prefix'), parameters('domain'))]",
    "ga": "[format('{0}-ga', parameters('prefix'))]",
    "gb": "[format('{0}-gb', parameters('prefix'))]",
    "gc": "[format('{0}-gc', parameters('prefix'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Entra/users",
      "apiVersion": "2026-10-01-preview",
      "name": "[variables('u1')]",
      "properties": {
        "displayName": "[format('{0}-u1', parameters('prefix'))]",
        "accountEnabled": true,
        "usageLocation": "GB"
      }
    },
    {
      "type": "Microsoft.Entra/users",
      "apiVersion": "2026-10-01-preview",
      "name": "[variables('u2')]",
      "properties": {
        "displayName": "[format('{0}-u2', parameters('prefix'))]",
        "accountEnabled": true,
        "usageLocation": "GB",
        "passwordProfile": { "password": "[parameters('u2Password')]", "forceChangePasswordNextSignIn": true },
        "memberOf": ["[reference(variables('gc')).id]"],
        "ownerOf": ["[reference(variables('gb')).id]"]
      }
    },
    {
      "type": "Microsoft.Entra/groups",
      "apiVersion": "2026-10-01-preview",
      "name": "[variables('ga')]",
      "properties": {
        "displayName": "[variables('ga')]",
        "mailEnabled": false,
        "mailNickname": "[variables('ga')]",
        "securityEnabled": true,
        "members": ["[reference(variables('u1')).id]"],
        "owners": ["[reference(variables('u1')).id]"]
      }
    },
    {
      "type": "Microsoft.Entra/groups",
      "apiVersion": "2026-10-01-preview",
      "name": "[variables('gb')]",
      "properties": {
        "displayName": "[variables('gb')]",
        "mailEnabled": false,
        "mailNickname": "[variables('gb')]",
        "securityEnabled": true,
        "memberOf": ["[reference(variables('gc')).id]"]
      }
    },
    {
      "type": "Microsoft.Entra/groups",
      "apiVersion": "2026-10-01-preview",
      "name": "[variables('gc')]",
      "properties": {
        "displayName": "[variables('gc')]",
        "mailEnabled": false,
        "mailNickname": "[variables('gc')]",
        "securityEnabled": true
      }
    }
  ]
}
