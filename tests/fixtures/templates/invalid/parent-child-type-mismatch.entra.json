{
  "$schema": "https://entraarm.dev/schemas/2026-10-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "resources": [
    {
      "type": "Microsoft.Entra/groups",
      "apiVersion": "2026-10-01",
      "name": "orders-admins",
      "properties": { "displayName": "Orders Admins", "mailEnabled": false, "securityEnabled": true },
      "resources": [
        {
          "type": "federatedIdentityCredentials",
          "apiVersion": "2026-10-01",
          "name": "github-main",
          "properties": { "issuer": "https://token.actions.githubusercontent.com", "subject": "repo:contoso/orders:ref:refs/heads/main" }
        }
      ]
    }
  ]
}
