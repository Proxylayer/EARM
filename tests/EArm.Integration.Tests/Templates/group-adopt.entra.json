{
  "$schema": "https://schema.earm.proxylayer.net/schemas/2026-10-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "One security group whose uniqueName differs from its displayName, so a group created outside EARM (no uniqueName) with that displayName is adopted."
  },
  "parameters": {
    "prefix":            { "type": "string" },
    "uniqueNameSuffix":  { "type": "string", "defaultValue": "adopt-u" },
    "displayNameSuffix": { "type": "string", "defaultValue": "adopt" }
  },
  "variables": {
    "uniqueName":  "[format('{0}-{1}', parameters('prefix'), parameters('uniqueNameSuffix'))]",
    "displayName": "[format('{0}-{1}', parameters('prefix'), parameters('displayNameSuffix'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Entra/groups",
      "apiVersion": "2026-10-01-preview",
      "name": "[variables('uniqueName')]",
      "properties": {
        "displayName": "[variables('displayName')]",
        "description": "Adopted by the EARM integration tests",
        "mailEnabled": false,
        "mailNickname": "[variables('displayName')]",
        "securityEnabled": true
      }
    }
  ]
}
