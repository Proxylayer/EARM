{
  "$schema": "https://schema.earm.proxylayer.net/schemas/2026-10-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "WI-19: addresses a hand-created application by the uniqueName that state adopt backfilled."
  },
  "parameters": {
    "prefix":      { "type": "string" },
    "homePageUrl": { "type": "string", "defaultValue": "https://earm-it.example.test/home" }
  },
  "variables": {
    "appName": "[format('{0}-adopt-app', parameters('prefix'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Entra/applications",
      "apiVersion": "2026-10-01-preview",
      "name": "[variables('appName')]",
      "properties": {
        "displayName": "[variables('appName')]",
        "signInAudience": "AzureADMyOrg",
        "web": { "homePageUrl": "[parameters('homePageUrl')]" }
      }
    }
  ],
  "outputs": {
    "appId": { "type": "string", "value": "[reference(variables('appName')).appId]" }
  }
}
