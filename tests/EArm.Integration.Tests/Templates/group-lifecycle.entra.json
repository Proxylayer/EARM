{
  "$schema": "https://schema.earm.proxylayer.net/schemas/2026-10-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "A Selected group expiration policy (deployed only into a tenant that has none) and a prefixed Microsoft 365 group joining it through its groupLifecyclePolicies edge."
  },
  "parameters": {
    "prefix": { "type": "string" },
    "groupLifetimeInDays": { "type": "int", "defaultValue": 180 }
  },
  "resources": [
    {
      "type": "Microsoft.Entra/groupLifecyclePolicies",
      "apiVersion": "2026-10-01-preview",
      "name": "default",
      "properties": {
        "groupLifetimeInDays": "[parameters('groupLifetimeInDays')]",
        "managedGroupTypes": "Selected"
      }
    },
    {
      "type": "Microsoft.Entra/groups",
      "apiVersion": "2026-10-01-preview",
      "name": "[format('{0}-glp-team', parameters('prefix'))]",
      "properties": {
        "displayName": "[format('{0}-glp-team', parameters('prefix'))]",
        "groupTypes": [ "Unified" ],
        "mailEnabled": true,
        "securityEnabled": false,
        "mailNickname": "[format('{0}-glp', parameters('prefix'))]",
        "groupLifecyclePolicies": [ "[reference(resourceId('Microsoft.Entra/groupLifecyclePolicies', 'default')).id]" ]
      }
    }
  ]
}
