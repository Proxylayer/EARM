{
  "$schema": "https://schema.earm.proxylayer.net/schemas/2026-10-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Samples/orders-api.entra.json under the run prefix, with the parts that need tenant-specific inputs removed (Key Vault password, manager, licenses, the all-staff group). Every resource type of the sample, edges from both sides, nested children, standalone assignments and grants."
  },
  "parameters": {
    "prefix":          { "type": "string" },
    "domain":          { "type": "string" },
    "contextId":       { "type": "string" },
    "initialPassword": { "type": "securestring" },
    "officeCidrs":     { "type": "array", "defaultValue": ["203.0.113.0/24"] }
  },
  "variables": {
    "apiName":    "[format('{0}-api', parameters('prefix'))]",
    "adminsName": "[format('{0}-admins', parameters('prefix'))]",
    "userName":   "[format('{0}-bg@{1}', parameters('prefix'), parameters('domain'))]",
    "supportRole": "[format('{0}-support', parameters('prefix'))]",
    "unitName":   "[format('{0}-orders-au', parameters('prefix'))]",
    "strength":   "[format('{0}-phishing-resistant', parameters('prefix'))]",
    "offices":    "[format('{0}-offices', parameters('prefix'))]",
    "policy":     "[format('{0}-ca-admins-mfa', parameters('prefix'))]",
    "graphAppId": "[wellKnownApp('MicrosoftGraph')]",
    "graphSpId":  "[reference(resourceId('Microsoft.Entra/servicePrincipals', variables('graphAppId')), '2026-10-01-preview').id]"
  },
  "resources": [
    {
      "type": "Microsoft.Entra/applications",
      "apiVersion": "2026-10-01-preview",
      "name": "[variables('apiName')]",
      "properties": {
        "displayName": "[variables('apiName')]",
        "signInAudience": "AzureADMyOrg",
        "identifierUris": ["api://{appId}"],
        "appRoles": [
          {
            "id": "6d2f1c0e-2b7a-4c1e-9a1b-4f3f1f6a2002",
            "value": "Orders.Admin",
            "displayName": "Orders admin",
            "description": "Full order management",
            "allowedMemberTypes": ["User", "Application"],
            "isEnabled": true
          }
        ],
        "requiredResourceAccess": [
          {
            "resourceAppId": "[variables('graphAppId')]",
            "resourceAccess": [{ "id": "[permissionScope(variables('graphAppId'), 'User.Read')]", "type": "Scope" }]
          }
        ],
        "owners": ["[reference(variables('userName')).id]"]
      },
      "dependsOn": ["[resourceId('Microsoft.Entra/users', variables('userName'))]"],
      "resources": [
        {
          "type": "federatedIdentityCredentials",
          "apiVersion": "2026-10-01-preview",
          "copy": { "name": "fics", "count": 2, "mode": "parallel" },
          "name": "[format('github-{0}', copyIndex('fics'))]",
          "properties": {
            "issuer": "https://token.actions.githubusercontent.com",
            "subject": "[format('repo:earm-it/orders:ref:refs/heads/branch-{0}', copyIndex('fics'))]",
            "audiences": ["api://AzureADTokenExchange"]
          }
        },
        {
          "type": "passwordCredentials",
          "apiVersion": "2026-10-01-preview",
          "name": "ci-secret",
          "properties": { "rotationTag": "2026Q4" }
        }
      ]
    },
    {
      "type": "Microsoft.Entra/servicePrincipals",
      "apiVersion": "2026-10-01-preview",
      "name": "[reference(variables('apiName')).appId]",
      "properties": { "appRoleAssignmentRequired": true },
      "dependsOn": ["[resourceId('Microsoft.Entra/applications', variables('apiName'))]"]
    },
    {
      "type": "Microsoft.Entra/users",
      "apiVersion": "2026-10-01-preview",
      "name": "[variables('userName')]",
      "properties": {
        "displayName": "[format('{0}-bg', parameters('prefix'))]",
        "accountEnabled": true,
        "usageLocation": "GB",
        "passwordProfile": { "password": "[parameters('initialPassword')]", "forceChangePasswordNextSignIn": true },
        "memberOf": ["[reference(variables('adminsName')).id]"],
        "ownerOf": ["[reference(variables('apiName')).id]"],
        "administrativeUnits": ["[reference(variables('unitName')).id]"],
        "appRoleAssignments": [
          { "resourceAppId": "[reference(variables('apiName')).appId]", "appRole": "Orders.Admin" }
        ]
      }
    },
    {
      "type": "Microsoft.Entra/groups",
      "apiVersion": "2026-10-01-preview",
      "name": "[variables('adminsName')]",
      "properties": {
        "displayName": "[variables('adminsName')]",
        "mailEnabled": false,
        "mailNickname": "[variables('adminsName')]",
        "securityEnabled": true,
        "isAssignableToRole": true,
        "members": ["[reference(resourceId('Microsoft.Entra/servicePrincipals', reference(variables('apiName')).appId)).id]"],
        "directoryRoles": [
          { "role": "Directory Readers", "directoryScopeId": "/" },
          { "role": "[reference(variables('supportRole')).id]", "directoryScopeId": "[format('/administrativeUnits/{0}', reference(variables('unitName')).id)]" }
        ]
      },
      "dependsOn": ["[resourceId('Microsoft.Entra/servicePrincipals', reference(variables('apiName')).appId)]"]
    },
    {
      "type": "Microsoft.Entra/roleDefinitions",
      "apiVersion": "2026-10-01-preview",
      "name": "[variables('supportRole')]",
      "properties": {
        "description": "Reset passwords for Orders staff",
        "isEnabled": true,
        "rolePermissions": [
          { "allowedResourceActions": ["microsoft.directory/users/password/update", "microsoft.directory/users/standard/read"] }
        ]
      }
    },
    {
      "type": "Microsoft.Entra/conditionalAccess/authenticationStrengths",
      "apiVersion": "2026-10-01-preview",
      "name": "[variables('strength')]",
      "properties": { "description": "FIDO2 or WHfB only", "allowedCombinations": ["fido2", "windowsHelloForBusiness"] }
    },
    {
      "type": "Microsoft.Entra/conditionalAccess/authenticationContextClassReferences",
      "apiVersion": "2026-10-01-preview",
      "name": "[parameters('contextId')]",
      "properties": { "displayName": "[format('{0}-orders-ctx', parameters('prefix'))]", "description": "Step-up for order refunds", "isAvailable": true }
    },
    {
      "type": "Microsoft.Entra/appRoleAssignments",
      "apiVersion": "2026-10-01-preview",
      "name": "[guid(variables('adminsName'), variables('apiName'), 'Orders.Admin')]",
      "properties": {
        "principalId": "[reference(variables('adminsName')).id]",
        "resourceId": "[reference(resourceId('Microsoft.Entra/servicePrincipals', reference(variables('apiName')).appId)).id]",
        "appRoleId": "[appRole(reference(variables('apiName')).appId, 'Orders.Admin')]"
      },
      "dependsOn": ["[resourceId('Microsoft.Entra/groups', variables('adminsName'))]"]
    },
    {
      "type": "Microsoft.Entra/oauth2PermissionGrants",
      "apiVersion": "2026-10-01-preview",
      "name": "[guid(variables('apiName'), variables('graphAppId'), 'AllPrincipals')]",
      "properties": {
        "clientId": "[reference(resourceId('Microsoft.Entra/servicePrincipals', reference(variables('apiName')).appId)).id]",
        "resourceId": "[variables('graphSpId')]",
        "consentType": "AllPrincipals",
        "scope": "User.Read"
      },
      "dependsOn": ["[resourceId('Microsoft.Entra/servicePrincipals', reference(variables('apiName')).appId)]"]
    },
    {
      "type": "Microsoft.Entra/conditionalAccess/namedLocations",
      "apiVersion": "2026-10-01-preview",
      "name": "[variables('offices')]",
      "properties": {
        "@odata.type": "#microsoft.graph.ipNamedLocation",
        "isTrusted": true,
        "ipRanges": "[map(parameters('officeCidrs'), lambda('c', createObject('cidrAddress', lambdaVariables('c'))))]"
      }
    },
    {
      "type": "Microsoft.Entra/conditionalAccess/policies",
      "apiVersion": "2026-10-01-preview",
      "name": "[variables('policy')]",
      "properties": {
        "state": "enabledForReportingButNotEnforced",
        "conditions": {
          "users": { "includeGroups": ["[reference(variables('adminsName')).id]"] },
          "applications": { "includeApplications": ["All"], "includeAuthenticationContextClassReferences": ["[parameters('contextId')]"] },
          "clientAppTypes": ["all"],
          "locations": { "includeLocations": ["All"], "excludeLocations": ["[reference(variables('offices')).id]"] }
        },
        "grantControls": { "operator": "OR", "authenticationStrength": { "id": "[reference(variables('strength')).id]" } }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Entra/groups', variables('adminsName'))]",
        "[resourceId('Microsoft.Entra/conditionalAccess/namedLocations', variables('offices'))]",
        "[resourceId('Microsoft.Entra/conditionalAccess/authenticationContextClassReferences', parameters('contextId'))]"
      ]
    },
    {
      "type": "Microsoft.Entra/administrativeUnits",
      "apiVersion": "2026-10-01-preview",
      "name": "[variables('unitName')]",
      "properties": {
        "description": "Scoped admin for Orders",
        "members": ["[reference(variables('userName')).id]"]
      },
      "dependsOn": ["[resourceId('Microsoft.Entra/users', variables('userName'))]"]
    },
    {
      "type": "Microsoft.Entra/roleAssignments",
      "apiVersion": "2026-10-01-preview",
      "name": "[guid(reference(variables('apiName')).appId, 'Directory Readers', '/')]",
      "properties": {
        "roleDefinitionId": "[roleTemplate('Directory Readers')]",
        "principalId": "[reference(resourceId('Microsoft.Entra/servicePrincipals', reference(variables('apiName')).appId)).id]",
        "directoryScopeId": "/"
      },
      "dependsOn": ["[resourceId('Microsoft.Entra/servicePrincipals', reference(variables('apiName')).appId)]"]
    }
  ],
  "outputs": {
    "apiAppId": { "type": "string", "value": "[reference(variables('apiName')).appId]" },
    "ciSecret": {
      "type": "securestring",
      "value": "[reference(resourceId('Microsoft.Entra/applications/passwordCredentials', variables('apiName'), 'ci-secret')).secretText]"
    }
  }
}
