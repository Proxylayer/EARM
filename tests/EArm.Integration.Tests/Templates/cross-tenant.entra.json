{
  "$schema": "https://schema.earm.proxylayer.net/schemas/2026-10-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "One inbound trust toggle of the default cross-tenant access configuration (the test snapshots and restores it) and a partner configuration for a partner tenant that has none yet."
  },
  "parameters": {
    "prefix": { "type": "string" },
    "partnerTenantId": { "type": "string" },
    "hybridJoinAccepted": { "type": "string", "allowedValues": [ "true", "false" ] }
  },
  "resources": [
    {
      "type": "Microsoft.Entra/policies/crossTenantAccessPolicy",
      "apiVersion": "2026-10-01-preview",
      "name": "default",
      "properties": {
        "inboundTrust": { "isHybridAzureADJoinedDeviceAccepted": "[bool(parameters('hybridJoinAccepted'))]" }
      }
    },
    {
      "type": "Microsoft.Entra/policies/crossTenantAccessPolicy/partners",
      "apiVersion": "2026-10-01-preview",
      "name": "[parameters('partnerTenantId')]",
      "properties": {
        "inboundTrust": { "isMfaAccepted": true, "isCompliantDeviceAccepted": false, "isHybridAzureADJoinedDeviceAccepted": false }
      }
    }
  ]
}
