{
  "$schema": "https://schema.earm.proxylayer.net/schemas/2026-10-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "An administrative unit keyed by displayName; state adopt --object-id pins it to the intended object."
  },
  "parameters": {
    "prefix":      { "type": "string" },
    "description": { "type": "string", "defaultValue": "managed by EARM" }
  },
  "variables": {
    "unit": "[format('{0}-pin-au', parameters('prefix'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Entra/administrativeUnits",
      "apiVersion": "2026-10-01-preview",
      "name": "[variables('unit')]",
      "properties": {
        "description": "[parameters('description')]"
      }
    }
  ]
}
