<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Real-tenant tests. Only run by test.ps1 when EARM_IT_TENANT is set (or when this project is
    named with -Target); every test skips cleanly when the variable is unset. See README.md.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/EArm.Cli/EArm.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The deployment templates the scenarios run travel with the test binaries. -->
    <None Update="Templates/**/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
