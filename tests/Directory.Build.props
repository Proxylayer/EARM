<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Test projects are never packed; xunit.v3 test projects are executables.
    Tests run on Microsoft.Testing.Platform (dotnet test is opted in via global.json "test.runner"; xunit.v3 4.x
    does not support the VSTest path on the .NET 10 SDK). UseMicrosoftTestingPlatformRunner makes the test
    executables expose the same MTP command line that dotnet test drives.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <!--
    Safety net: GraphAuthFactory.Logout throws instead of deleting earm token-cache files in the platform cache
    directories (%LOCALAPPDATA%\.IdentityService, ~/.IdentityService), so no unit test can wipe the developer's real
    sign-in. The switch lands in each test executable's runtimeconfig.json, so it is on before any test code runs.
    The live integration suite signs in for real and is left out.
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'EArm.Integration.Tests'">
    <RuntimeHostConfigurationOption Include="EArm.Graph.Auth.ForbidPlatformTokenCacheDeletion" Value="true" />
  </ItemGroup>

</Project>
