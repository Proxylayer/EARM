<?xml version="1.0" encoding="utf-8"?>
<!-- Package restore uses nuget.org only, whatever feeds the machine-level configuration adds. The source mapping sends every package
     to nuget.org, so Central Package Management never warns about multiple sources (NU1507, an error under TreatWarningsAsErrors). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
